#!/usr/bin/env python3
"""Omabar's Spotify helper.

    omabar-spotify play <spotify uri or open.spotify.com link>
        Start Spotify if needed and play that playlist, album or track.
    omabar-spotify liked [--no-shuffle]
        Start Spotify if needed, turn shuffle on and play your Liked Songs.
    omabar-spotify playlists
        Print your playlists as JSON (needs a one-time `login`).
    omabar-spotify login
        Connect your Spotify account so the player can list your playlists.
    omabar-spotify status
        Print whether an account is connected.
    omabar-spotify set-discover-weekly [link]
        Save your Discover Weekly link for the player's one-click button.

Playback goes through Spotify's own MPRIS interface on the session bus (with
busctl, which every systemd desktop has), so `play` works without logging in. Listing playlists uses the Spotify Web API with your own app's
client id (PKCE, no client secret). The token is stored in
~/.config/omabar/spotify-token.json, readable only by you.
"""
import base64
import fcntl
import hashlib
import http.server
import json
import os
import random
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omabar")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "omabar")
APP_FILE = os.path.join(CONFIG_DIR, "spotify.json")
TOKEN_FILE = os.path.join(CONFIG_DIR, "spotify-token.json")
CACHE_FILE = os.path.join(CACHE_DIR, "playlists.json")
CACHE_SECONDS = 600

REDIRECT_PORT = 8898
REDIRECT_URI = f"http://127.0.0.1:{REDIRECT_PORT}/callback"
# The playback and library scopes are only used to start Liked Songs, which
# Spotify's own MPRIS interface opens but doesn't play (see cmd_liked).
PLAY_SCOPE = "user-modify-playback-state"
SCOPES = f"playlist-read-private playlist-read-collaborative user-library-read user-read-playback-state {PLAY_SCOPE}"


# ── helpers ───────────────────────────────────────────────────────────────

KINDS = "playlist|album|track|artist|show|episode"
MPRIS_NAME = "org.mpris.MediaPlayer2.spotify"
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_PLAYER = "org.mpris.MediaPlayer2.Player"


def to_uri(value):
    """Accept spotify:… URIs and open.spotify.com links; return a spotify: URI."""
    value = value.strip()
    # Older links carry the owner: spotify:user:<name>:playlist:<id>.
    match = re.fullmatch(rf"spotify:(?:user:[^:]+:)?({KINDS}):([A-Za-z0-9]+)", value)
    if match:
        return f"spotify:{match.group(1)}:{match.group(2)}"
    if re.fullmatch(r"spotify:[A-Za-z0-9:_-]+", value):
        return value
    match = re.match(rf"https?://open\.spotify\.com/(?:intl-[a-z-]+/)?(?:user/[^/]+/)?({KINDS})/([A-Za-z0-9]+)", value)
    if match:
        return f"spotify:{match.group(1)}:{match.group(2)}"
    raise SystemExit(f"omabar-spotify: not a Spotify link or URI: {value}")


def to_web(uri):
    parts = uri.split(":")
    if len(parts) == 3 and re.fullmatch(KINDS, parts[1]):
        return f"https://open.spotify.com/{parts[1]}/{parts[2]}"
    return "https://open.spotify.com/"


def busctl(*args):
    """Run busctl on the session bus; None when it can't be run or hangs.
    Omarchy 4 no longer installs playerctl, so MPRIS is spoken directly."""
    try:
        return subprocess.run(["busctl", "--user", "--timeout=4", *args],
                              capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.TimeoutExpired):
        return None


def playback_status():
    """"Playing", "Paused" or "Stopped"; "" when Spotify isn't on the bus or
    isn't answering (closed, starting up, or shutting down)."""
    result = busctl("get-property", MPRIS_NAME, MPRIS_PATH, MPRIS_PLAYER, "PlaybackStatus")
    if result is None or result.returncode != 0:
        return ""
    match = re.search(r'"(\w+)"', result.stdout)
    return match.group(1) if match else ""


def spotify_running():
    return playback_status() != ""


def open_uri(uri):
    result = busctl("call", MPRIS_NAME, MPRIS_PATH, MPRIS_PLAYER, "OpenUri", "s", uri)
    return result is not None and result.returncode == 0


def read_json(path, fallback=None):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_private(path, data):
    """Write JSON readable only by you, replacing the file in one step so a
    reader never sees half of it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    partial = f"{path}.{os.getpid()}.tmp"
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(data, handle)
    os.replace(partial, path)


def api_request(url, data=None, headers=None):
    request = urllib.request.Request(url, data=data, headers=headers or {})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


# ── play ──────────────────────────────────────────────────────────────────

def single_play():
    """Hold the play lock, or None when another play is already under way: a
    second click while Spotify is still starting would otherwise queue a
    second launch and a second request."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    lock = open(os.path.join(CACHE_DIR, "play.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None
    return lock


def ensure_running():
    """Start the desktop app when it isn't up. True when it was just started."""
    if spotify_running() or not (shutil.which("spotify") and shutil.which("omarchy-launch-spotify")):
        return False
    subprocess.Popen(["omarchy-launch-spotify"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(60):
        time.sleep(0.5)
        if spotify_running():
            time.sleep(1.5)  # on the bus a moment before it takes requests
            return True
    return False


def open_web(url):
    subprocess.Popen(["xdg-open", url], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_play(target):
    uri = to_uri(target)
    lock = single_play()
    if lock is None:
        return 0
    ensure_running()
    if spotify_running():
        # A Spotify that is still signing in, or restarting, can accept the
        # request and drop it. Ask again until it is actually playing.
        for attempt in range(4):
            sent = open_uri(uri)
            time.sleep(2.5)
            if sent and playback_status() == "Playing":
                return 0
        return 0 if sent else 1
    # No desktop app (or it never came up): open the page instead.
    open_web(to_web(uri))
    return 0


# ── liked songs ───────────────────────────────────────────────────────────

# Liked Songs isn't a playlist and has no link to share. These are the names
# Spotify's desktop app knows it by.
LIKED_URIS = ["spotify:collection:tracks", "spotify:collection"]
LIKED_WEB = "https://open.spotify.com/collection/tracks"


def track_id():
    result = busctl("get-property", MPRIS_NAME, MPRIS_PATH, MPRIS_PLAYER, "Metadata")
    if result is None or result.returncode != 0:
        return ""
    match = re.search(r'"mpris:trackid" \w "([^"]*)"', result.stdout)
    return match.group(1) if match else ""


def set_shuffle(on):
    result = busctl("set-property", MPRIS_NAME, MPRIS_PATH, MPRIS_PLAYER, "Shuffle", "b", "true" if on else "false")
    return result is not None and result.returncode == 0


def notify(text):
    try:
        subprocess.run(["notify-send", "-a", "Omabar", "Spotify", text], capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def api_send(method, url, token, body=None):
    """A Web API call with no answer to read. True when Spotify accepted it."""
    request = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body is not None else b"",
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=10) as response:
        return 200 <= response.status < 300


def can_play():
    """Whether the saved login lets Omabar control playback."""
    token = read_json(TOKEN_FILE)
    return isinstance(token, dict) and bool(client_id()) and PLAY_SCOPE in str(token.get("scope", ""))


def premium_needed(error):
    try:
        return "PREMIUM_REQUIRED" in error.read().decode("utf-8", "replace")
    except (OSError, ValueError):
        return False


def this_device(auth):
    """The Spotify app on this computer, as the Web API names it. A just-started
    app takes a few seconds to appear."""
    for _ in range(8):
        devices = api_request("https://api.spotify.com/v1/me/player/devices", headers=auth).get("devices") or []
        usable = [d for d in devices if d.get("id") and not d.get("is_restricted")]
        here = [d for d in usable if d.get("type") == "Computer"] or usable
        if here:
            return here[0]["id"]
        time.sleep(1)
    return ""


def liked_uris(auth, shuffle):
    """Up to 200 of your Liked Songs: the newest, or with shuffle a random
    spread across the whole library in random order."""
    first = api_request("https://api.spotify.com/v1/me/tracks?limit=50", headers=auth)
    total = int(first.get("total") or 0)
    offsets = list(range(50, total, 50))
    if shuffle:
        random.shuffle(offsets)
    pages = [first] + [api_request(f"https://api.spotify.com/v1/me/tracks?limit=50&offset={offset}", headers=auth)
                       for offset in offsets[:3]]
    uris = [(item.get("track") or {}).get("uri") for page in pages for item in page.get("items") or [] if item]
    uris = [uri for uri in uris if uri and uri.startswith("spotify:track:")]
    if shuffle:
        random.shuffle(uris)
    return uris


def web_play_liked(shuffle):
    """Start Liked Songs through the Web API. Returns "ok", "login" (the saved
    login can't control playback), "premium" (Spotify only allows this with
    Premium), "device" (the app isn't showing up) or "failed"."""
    try:
        if not can_play():
            return "login"
        token = access_token()
        if not token:
            return "login"
        auth = {"Authorization": f"Bearer {token}"}
        device = urllib.parse.quote(this_device(auth))
        if not device:
            return "device"
        play = f"https://api.spotify.com/v1/me/player/play?device_id={device}"
        try:
            # Liked Songs as Spotify itself plays it: the whole library.
            user = api_request("https://api.spotify.com/v1/me", headers=auth).get("id") or ""
            if not user:
                raise ValueError("no user id")
            if shuffle:
                try:
                    api_send("PUT", f"https://api.spotify.com/v1/me/player/shuffle?state=true&device_id={device}", token)
                except urllib.error.HTTPError as error:
                    if premium_needed(error):
                        return "premium"
            api_send("PUT", play, token, {"context_uri": f"spotify:user:{user}:collection"})
            if shuffle:
                # Shuffle set on an idle app may not have counted for the first
                # song, so set it again now and move off the top of the list.
                try:
                    time.sleep(1)
                    api_send("PUT", f"https://api.spotify.com/v1/me/player/shuffle?state=true&device_id={device}", token)
                    api_send("POST", f"https://api.spotify.com/v1/me/player/next?device_id={device}", token)
                except (urllib.error.URLError, OSError):
                    pass
            return "ok"
        except urllib.error.HTTPError as error:
            if error.code in (401, 403) and premium_needed(error):
                return "premium"
            if error.code == 401:
                return "login"
        except ValueError:
            pass
        # Spotify wouldn't take Liked Songs as a whole: send the songs themselves.
        uris = liked_uris(auth, shuffle)
        if not uris:
            return "failed"
        api_send("PUT", play, token, {"uris": uris})
        return "ok"
    except NeedsLogin:
        return "login"
    except urllib.error.HTTPError as error:
        if premium_needed(error):
            return "premium"
        return "login" if error.code in (401, 403) else "failed"
    except (urllib.error.URLError, OSError, ValueError, KeyError, TypeError, AttributeError):
        return "failed"


def ask_for_playback(shuffle):
    """Open the one-time approval in a terminal; it starts Liked Songs when done."""
    if not shutil.which("omarchy-launch-floating-terminal-with-presentation"):
        return False
    command = [os.path.realpath(__file__), "login", "--then-liked"] + ([] if shuffle else ["--no-shuffle"])
    subprocess.Popen(["omarchy-launch-floating-terminal-with-presentation", shlex.join(command)],
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def cmd_liked(shuffle=True, may_ask=True):
    lock = single_play()
    if lock is None:
        return 0
    fresh = ensure_running()
    if not spotify_running():
        open_web(LIKED_WEB)
        return 0

    # With playback access, your Spotify account starts them directly.
    outcome = web_play_liked(shuffle)
    if outcome == "ok":
        return 0

    # Otherwise ask the app. Most versions only show the Liked Songs page, so
    # check that it is playing and, if it already was, has moved to another song.
    was_playing, was_track = playback_status() == "Playing", track_id()

    def started():
        return playback_status() == "Playing" and not (was_playing and track_id() == was_track)

    if shuffle:
        set_shuffle(True)
    # A just-started Spotify can drop the first request, so ask it twice.
    for uri in ([LIKED_URIS[0]] if fresh else []) + LIKED_URIS:
        if open_uri(uri):
            time.sleep(2.5)
            if started():
                return 0

    if outcome == "premium":
        notify("Liked Songs is open. Starting it from the bar needs Spotify Premium, so press play there.")
    elif outcome == "login" and may_ask and ask_for_playback(shuffle):
        pass  # the terminal takes it from here
    elif outcome == "login":
        notify("Liked Songs is open. To let Omabar start it, run: omabar-spotify login")
    elif outcome == "device":
        notify("Liked Songs is open, but Spotify's servers don't see the app on this computer yet. Try again in a moment.")
    else:
        notify("Liked Songs is open, but Spotify didn't start it from the bar. Press play there.")
    return 1


# ── auth ──────────────────────────────────────────────────────────────────

def client_id():
    app = read_json(APP_FILE, {})
    return (app or {}).get("client_id", "")


def cmd_login(then_liked=False, shuffle=True):
    cid = client_id()
    if then_liked:
        print("Spotify opens your Liked Songs from the bar but won't start them without your say-so.")
        print("Approve once in the browser and the Liked Songs button will start them from then on.")
        print("Starting playback this way needs Spotify Premium.\n")
    if not cid:
        print("To list your playlists, Omabar needs a Spotify app of your own (free, two minutes):\n")
        print("  1. Open https://developer.spotify.com/dashboard and create an app.")
        print(f"  2. Add this Redirect URI: {REDIRECT_URI}")
        print("  3. Tick 'Web API', save, and copy the app's Client ID.\n")
        cid = input("Client ID: ").strip().lower()
        if not re.fullmatch(r"[0-9a-f]{32}", cid):
            print("That doesn't look like a Client ID (32 hex characters).")
            return 1
        write_private(APP_FILE, {"client_id": cid})

    verifier = secrets.token_urlsafe(64)[:96]
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "client_id": cid, "response_type": "code", "redirect_uri": REDIRECT_URI,
        "code_challenge_method": "S256", "code_challenge": challenge,
        "scope": SCOPES, "state": state,
    })

    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] == state:
                result["code"] = query.get("code", [""])[0]
                result["error"] = query.get("error", [""])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<h2>Omabar is connected to Spotify. You can close this tab.</h2>".encode())

        def log_message(self, *args):
            pass

    try:
        server = http.server.HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
    except OSError as error:
        print(f"Couldn't listen on port {REDIRECT_PORT} for Spotify's answer ({error.strerror or error}).")
        print("Another login may still be open. Close it and try again.")
        return 1
    server.timeout = 1
    print("Opening Spotify in your browser to approve read access to your playlists…")
    webbrowser.open(url)
    deadline = time.time() + 300
    while "code" not in result and time.time() < deadline:
        server.handle_request()
    server.server_close()

    if not result.get("code"):
        print("Spotify didn't approve the login" + (f": {result['error']}" if result.get("error") else "."))
        return 1

    try:
        token = api_request("https://accounts.spotify.com/api/token", urllib.parse.urlencode({
            "grant_type": "authorization_code", "code": result["code"],
            "redirect_uri": REDIRECT_URI, "client_id": cid, "code_verifier": verifier,
        }).encode(), {"Content-Type": "application/x-www-form-urlencoded"})
    except urllib.error.HTTPError as error:
        print(f"Spotify refused the login ({error.code}). Check the app's Client ID and Redirect URI.")
        print(f"To enter the Client ID again, run: rm {APP_FILE} && {sys.argv[0]} login")
        return 1
    except (urllib.error.URLError, OSError, ValueError) as error:
        print(f"Couldn't reach Spotify: {error}")
        return 1
    if not token.get("access_token"):
        print("Spotify's answer had no login in it. Try again.")
        return 1
    token["expires_at"] = time.time() + token.get("expires_in", 3600) - 60
    write_private(TOKEN_FILE, token)
    try:
        os.remove(CACHE_FILE)
    except OSError:
        pass
    print("Connected. Your playlists will show in the Omabar player.")
    if then_liked:
        print("Starting your Liked Songs…")
        if cmd_liked(shuffle, may_ask=False) != 0:
            print("Spotify didn't start them. See the notification for why.")
            return 1
    return 0


class NeedsLogin(Exception):
    """Spotify no longer accepts the saved login."""


def access_token(force=False):
    """A usable access token, None when no account is connected. Raises
    NeedsLogin when the saved login was revoked or has expired for good."""
    token = read_json(TOKEN_FILE)
    cid = client_id()
    if not isinstance(token, dict) or not cid:
        return None
    if not force and token.get("access_token") and time.time() < token.get("expires_at", 0):
        return token["access_token"]
    if not token.get("refresh_token"):
        raise NeedsLogin()
    try:
        fresh = api_request("https://accounts.spotify.com/api/token", urllib.parse.urlencode({
            "grant_type": "refresh_token", "refresh_token": token["refresh_token"], "client_id": cid,
        }).encode(), {"Content-Type": "application/x-www-form-urlencoded"})
    except urllib.error.HTTPError as error:
        if error.code in (400, 401, 403):  # invalid_grant, invalid_client
            raise NeedsLogin() from error
        raise
    if not fresh.get("access_token"):
        raise NeedsLogin()
    fresh.setdefault("refresh_token", token["refresh_token"])
    if token.get("scope"):
        fresh.setdefault("scope", token["scope"])   # what the login was approved for
    fresh["expires_at"] = time.time() + fresh.get("expires_in", 3600) - 60
    write_private(TOKEN_FILE, fresh)
    return fresh["access_token"]


# ── playlists ─────────────────────────────────────────────────────────────

EXPIRED = "Your Spotify login expired. Connect again to refresh your playlists."


def problem_text(error):
    if isinstance(error, urllib.error.HTTPError):
        if error.code == 429:
            return "Spotify is rate limiting requests. Try again in a minute."
        return f"Spotify answered with an error ({error.code})."
    return "Couldn't reach Spotify. Check your connection."


def fetch_playlists(token):
    playlists = []
    url = "https://api.spotify.com/v1/me/playlists?limit=50"
    while url and len(playlists) < 200:
        page = api_request(url, headers={"Authorization": f"Bearer {token}"})
        for item in page.get("items") or []:
            if not item or not item.get("uri"):
                continue
            images = item.get("images") or []
            playlists.append({
                "name": item.get("name") or "Untitled playlist",
                "uri": item["uri"],
                "owner": (item.get("owner") or {}).get("display_name") or "",
                "tracks": ((item.get("tracks") or item.get("items") or {}).get("total") or 0),
                "image": (images[-1].get("url") or "") if images else "",
            })
        url = page.get("next")
    return playlists


def cmd_playlists():
    cached = read_json(CACHE_FILE)
    if not isinstance(cached, dict) or not isinstance(cached.get("playlists"), list):
        cached = None
    if cached and time.time() - cached.get("at", 0) < CACHE_SECONDS:
        print(json.dumps({"connected": True, "playlists": cached["playlists"]}))
        return 0
    # Whatever goes wrong, keep showing the last list that loaded.
    stale = cached["playlists"] if cached else []

    def answer(connected, error=""):
        print(json.dumps({"connected": connected, "error": error, "playlists": stale}))
        return 0

    try:
        token = access_token()
        if not token:
            return answer(False)
        try:
            playlists = fetch_playlists(token)
        except urllib.error.HTTPError as error:
            if error.code != 401:
                raise
            # The token was revoked before its time was up: get a new one once.
            playlists = fetch_playlists(access_token(force=True))
    except NeedsLogin:
        return answer(False, EXPIRED)
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            return answer(False, EXPIRED)
        return answer(True, problem_text(error))
    except (urllib.error.URLError, OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        return answer(True, problem_text(error))

    os.makedirs(CACHE_DIR, exist_ok=True)
    write_private(CACHE_FILE, {"at": time.time(), "playlists": playlists})
    print(json.dumps({"connected": True, "playlists": playlists}))
    return 0


def cmd_status():
    print("connected" if read_json(TOKEN_FILE) and client_id() else "not connected")
    return 0


def cmd_set_discover(link=None):
    if not link:
        print("Open Discover Weekly in Spotify, choose Share > Copy link to playlist, and paste it here.\n")
        link = input("Link: ").strip()
    try:
        uri = to_uri(link)
    except SystemExit:
        uri = ""
    if not uri.startswith("spotify:playlist:"):
        print("That's not a playlist link. It looks like https://open.spotify.com/playlist/…")
        return 1
    try:
        result = subprocess.run(["omarchy", "bar", "set", "omabar-player", "discoverWeekly", uri])
    except OSError as error:
        print(f"Couldn't save it: {error}")
        return 1
    if result.returncode == 0:
        print("Saved. Discover Weekly is one click away in the player.")
    return result.returncode


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    command = argv[1]
    if command == "play" and len(argv) == 3:
        return cmd_play(argv[2])
    if command == "liked":
        return cmd_liked(shuffle="--no-shuffle" not in argv[2:])
    if command == "playlists":
        return cmd_playlists()
    if command == "login":
        return cmd_login("--then-liked" in argv[2:], "--no-shuffle" not in argv[2:])
    if command == "set-discover-weekly":
        return cmd_set_discover(argv[2] if len(argv) > 2 else None)
    if command == "status":
        return cmd_status()
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (KeyboardInterrupt, EOFError):
        sys.exit(130)
