#!/usr/bin/env python3
"""Omabar's Google Calendar helper.

    omabar-gcal connect
        The easy way: paste each calendar's "Secret address in iCal format"
        from Google Calendar's settings. Works for shared calendars too.
    omabar-gcal disconnect
        Remove calendars added with connect.
    omabar-gcal login
        Alternative: connect through a Google OAuth client of your own.
    omabar-gcal calendars
        Print every calendar you own or that is shared with you, with its
        Google color and whether Omabar shows it, as JSON.
    omabar-gcal toggle <calendar id>
        Show or hide one calendar in the bar's calendar.
    omabar-gcal events [YYYY-MM]
        Print events for that month (default: this month) plus the next 14
        days from the calendars you show, each with its Google color, as JSON.
    omabar-gcal status
        Print whether an account is connected.

Calendar addresses and tokens live in ~/.config/omabar/, readable only by you.
"""
import base64
import concurrent.futures
import datetime as dt
import hashlib
import http.server
import json
import os
import re
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

sys.dont_write_bytecode = True  # keep the plugin checkout clean
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import omabar_ical as ical  # noqa: E402

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omabar")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "omabar")
CLIENT_FILE = os.path.join(CONFIG_DIR, "google-client.json")
TOKEN_FILE = os.path.join(CONFIG_DIR, "google-token.json")
PREFS_FILE = os.path.join(CONFIG_DIR, "calendars.json")
ICAL_FILE = os.path.join(CONFIG_DIR, "ical-calendars.json")
# Google Calendar's own calendar colors, handed out in order to linked calendars.
PALETTE = ["#039be5", "#33b679", "#8e24aa", "#e67c73", "#f6bf26", "#f4511e",
           "#7986cb", "#0b8043", "#d50000", "#3f51b5", "#795548", "#616161"]
CACHE_SECONDS = 300

SCOPE = "https://www.googleapis.com/auth/calendar.readonly"
API = "https://www.googleapis.com/calendar/v3"


# ── storage ───────────────────────────────────────────────────────────────

def read_json(path, fallback=None):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_private(path, data):
    """Write JSON readable only by you, replacing the file in one step so a
    reader never sees half of it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    partial = f"{path}.{os.getpid()}.tmp"
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(data, handle)
    os.replace(partial, path)


def write_cache(name, data):
    # Cached feeds hold your events, so they are private too.
    write_private(os.path.join(CACHE_DIR, name), {"at": time.time(), "data": data})


def read_cache(name, max_age=None):
    """Cached data no older than max_age seconds; any age when max_age is None."""
    cached = read_json(os.path.join(CACHE_DIR, name))
    if not isinstance(cached, dict) or "data" not in cached:
        return None
    if max_age is None or 0 <= time.time() - cached.get("at", 0) < max_age:
        return cached["data"]
    return None


def clear_cache(prefix="gcal-", keep_feeds=False):
    for name in os.listdir(CACHE_DIR) if os.path.isdir(CACHE_DIR) else []:
        if name.startswith(prefix) and not (keep_feeds and name.startswith("gcal-ical-")):
            try:
                os.remove(os.path.join(CACHE_DIR, name))
            except OSError:
                pass


def local_zone():
    """The system's time zone by name (e.g. America/Los_Angeles), so times on
    the far side of a daylight-saving change come out right. A bare UTC offset
    is only correct for today."""
    names = [os.environ.get("TZ", "").lstrip(":")]
    try:
        path = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in path:
            names.append(re.sub(r"^(posix|right)/", "", path.split("/zoneinfo/", 1)[1]))
    except OSError:
        pass
    try:
        with open("/etc/timezone") as handle:
            names.append(handle.read().strip())
    except OSError:
        pass
    for name in names:
        found = ical.zone(name) if name else None
        if found is not None:
            return found
    return dt.datetime.now().astimezone().tzinfo


def post_form(url, fields):
    request = urllib.request.Request(url, data=urllib.parse.urlencode(fields).encode(),
                                     headers={"Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


# ── linked calendars (secret iCal addresses) ─────────────────────────────

def linked():
    data = read_json(ICAL_FILE, []) or []
    return data if isinstance(data, list) else []


def feed_url(url):
    return re.sub(r"^webcal://", "https://", url.strip(), flags=re.I)


def fetch_feed(url):
    request = urllib.request.Request(feed_url(url), headers={"User-Agent": "omabar-gcal"})
    with urllib.request.urlopen(request, timeout=15) as response:
        text = response.read(32 * 1024 * 1024).decode("utf-8", "replace")
    # A sign-in page or an error page also arrives as a 200.
    if "BEGIN:VCALENDAR" not in text[:4096].upper():
        raise ValueError("that address didn't return a calendar")
    return text


def feed_problem(error):
    """Why a calendar's feed couldn't be read, in a line a person can act on."""
    if isinstance(error, urllib.error.HTTPError):
        if error.code in (401, 403, 404, 410):
            return "its secret address no longer works. Remove it and add it again."
        return f"Google answered with an error ({error.code})."
    if isinstance(error, ValueError):
        return "its address didn't return a calendar. Remove it and add it again."
    return "couldn't reach Google. Check your connection."


def feed(calendar):
    """(feed text, problem). The text is cached for a few minutes. When Google
    can't be reached the last copy that loaded is used, however old, with the
    problem named; an address Google now refuses gives no text at all."""
    name = f"gcal-ical-{calendar['id']}.json"
    cached = read_cache(name, CACHE_SECONDS)
    if cached is not None:
        return cached, ""
    try:
        text = fetch_feed(calendar["url"])
    except (urllib.error.URLError, OSError, ValueError) as error:
        refused = isinstance(error, ValueError) or \
            (isinstance(error, urllib.error.HTTPError) and error.code in (401, 403, 404, 410))
        stale = None if refused else read_cache(name)
        return stale, feed_problem(error)
    write_cache(name, text)
    return text, ""


def cmd_connect():
    calendars = linked()
    print("Add your Google calendars to Omabar. No Google Cloud setup needed.\n")
    print("  1. Open Google Calendar's settings: https://calendar.google.com/calendar/r/settings")
    print("  2. On the left, click a calendar under \"Settings for my calendars\"")
    print("     or \"Settings for other calendars\" (your shared ones).")
    print("  3. Scroll to \"Integrate calendar\" and copy \"Secret address in iCal format\".\n")
    print("Paste one address per line. Press Enter on an empty line when you're done.")
    if calendars:
        print("Already added: " + ", ".join(c["name"] for c in calendars))
    added = 0
    while True:
        try:
            url = input("\nAddress: ").strip()
        except EOFError:
            break
        if not url:
            break
        if not re.match(r"^(https?|webcal)://", url, re.I):
            print("That isn't a calendar address. It starts with https://calendar.google.com/calendar/ical/")
            continue
        url = feed_url(url)
        if any(feed_url(c["url"]) == url for c in calendars):
            print("Already added.")
            continue
        try:
            parsed = ical.read_calendar(fetch_feed(url))
        except urllib.error.HTTPError as error:
            print(f"Google refused that address ({error.code}). Copy the secret address again; it may have been reset.")
            continue
        except ValueError:
            print("That address didn't return a calendar. Copy \"Secret address in iCal format\", not the public or embed address.")
            continue
        except (urllib.error.URLError, OSError) as error:
            print(f"Couldn't read that address: {getattr(error, 'reason', error)}")
            continue
        name = parsed["name"] or f"Calendar {len(calendars) + 1}"
        if "@" in name and len(calendars) == 0:
            name = "My calendar"
        try:
            shared = input(f"Found \"{name}\" ({len(parsed['events'])} events). Is it shared with you by someone else? [y/N] ").strip().lower().startswith("y")
        except EOFError:
            shared = False
        taken = {c.get("color") for c in calendars}
        calendars.append({
            "id": "ical-" + hashlib.sha1(url.encode()).hexdigest()[:12],
            "url": url,
            "name": name,
            "owned": not shared,
            "color": next((c for c in PALETTE if c not in taken), PALETTE[len(calendars) % len(PALETTE)]),
        })
        write_private(ICAL_FILE, calendars)
        added += 1
        print(f"Added {name}.")
    clear_cache()
    if calendars:
        print(f"\nDone. {len(calendars)} calendar{'s' if len(calendars) != 1 else ''} linked. Open the clock's calendar to see them.")
        return 0
    print("\nNo calendars added.")
    return 1


def cmd_disconnect():
    calendars = linked()
    if not calendars:
        print("No linked calendars.")
        return 0
    for i, c in enumerate(calendars, 1):
        print(f"  {i}. {c['name']}")
    try:
        answer = input("Remove which? (numbers separated by spaces, or 'all'): ").strip().lower()
    except EOFError:
        answer = ""
    if answer == "all":
        keep = []
    else:
        drop = {int(t) for t in answer.split() if t.isdigit()}
        keep = [c for i, c in enumerate(calendars, 1) if i not in drop]
    write_private(ICAL_FILE, keep)
    clear_cache()
    print(f"{len(calendars) - len(keep)} removed.")
    return 0


# ── auth ──────────────────────────────────────────────────────────────────

def client():
    data = read_json(CLIENT_FILE, {}) or {}
    data = data.get("installed", data)       # accept Google's downloaded JSON as-is
    return data.get("client_id", ""), data.get("client_secret", "")


def cmd_login():
    cid, secret = client()
    if not cid:
        print("Omabar reads your calendars through a Google OAuth client of your own (free, a few minutes):\n")
        print("  1. Open https://console.cloud.google.com/apis/library/calendar-json.googleapis.com and enable the Google Calendar API.")
        print("  2. Under APIs & Services > OAuth consent screen, set it up as External and add yourself as a test user.")
        print("  3. Under Credentials, create an OAuth client ID of type 'Desktop app'.\n")
        print("Then paste the client ID and secret, or the path to the JSON file Google lets you download.\n")
        answer = input("Client ID or JSON path: ").strip()
        path = os.path.expanduser(answer)
        if os.path.isfile(path):
            data = read_json(path, {}) or {}
            data = data.get("installed", data)
            cid, secret = data.get("client_id", ""), data.get("client_secret", "")
        else:
            cid = answer
            secret = input("Client secret: ").strip()
        if not cid.endswith(".apps.googleusercontent.com") or not secret:
            print("That doesn't look like a Desktop app client.")
            return 1
        write_private(CLIENT_FILE, {"client_id": cid, "client_secret": secret})

    verifier = secrets.token_urlsafe(64)[:96]
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] == state:
                result["code"] = query.get("code", [""])[0]
                result["error"] = query.get("error", [""])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<h2>Omabar is connected to Google Calendar. You can close this tab.</h2>".encode())

        def log_message(self, *args):
            pass

    # Google's loopback flow: any free port on 127.0.0.1.
    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    server.timeout = 1
    redirect = f"http://127.0.0.1:{server.server_port}"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": cid, "redirect_uri": redirect, "response_type": "code",
        "scope": SCOPE, "code_challenge": challenge, "code_challenge_method": "S256",
        "state": state, "access_type": "offline", "prompt": "consent",
    })
    print("Opening Google in your browser to approve read-only access to your calendars…")
    webbrowser.open(url)
    deadline = time.time() + 300
    while "code" not in result and time.time() < deadline:
        server.handle_request()
    server.server_close()

    if not result.get("code"):
        print("Google didn't approve the login" + (f": {result['error']}" if result.get("error") else "."))
        return 1

    try:
        token = post_form("https://oauth2.googleapis.com/token", {
            "code": result["code"], "client_id": cid, "client_secret": secret,
            "redirect_uri": redirect, "grant_type": "authorization_code", "code_verifier": verifier,
        })
    except urllib.error.HTTPError as error:
        print("Google refused the sign-in: " + google_error(error))
        print("Check the client ID and secret. To enter them again, run:")
        print(f"  rm {CLIENT_FILE} && {sys.argv[0]} login")
        return 1
    if not token.get("refresh_token"):
        print("Google didn't send a lasting login (no refresh token). Run login again.")
        return 1
    token["expires_at"] = time.time() + token.get("expires_in", 3600) - 60
    write_private(TOKEN_FILE, token)
    clear_cache()

    # Prove it works now, rather than leaving the bar to find out.
    try:
        found = len(api("/users/me/calendarList", maxResults=250).get("items", []))
    except urllib.error.HTTPError as error:
        print("Signed in, but Google Calendar refused the request: " + google_error(error))
        print("If it mentions the API being disabled, enable the Google Calendar API for this project:")
        print("  https://console.cloud.google.com/apis/library/calendar-json.googleapis.com")
        print(f"Then run: {sys.argv[0]} login")
        return 1
    print(f"Connected: {found} calendar{'s' if found != 1 else ''} found.")
    print("Open the clock's calendar again. Pick which calendars show from its Calendars button.")
    return 0


def google_error(error):
    """The reason Google gave for an HTTP error, as one line."""
    try:
        body = json.loads(error.read().decode() or "{}")
    except (ValueError, OSError):
        body = {}
    detail = body.get("error")
    if isinstance(detail, dict):
        return f"{error.code} {detail.get('message', '')}".strip()
    if detail:
        return f"{error.code} {detail}: {body.get('error_description', '')}".strip(": ")
    return f"{error.code} {error.reason}"


def access_token():
    token = read_json(TOKEN_FILE)
    cid, secret = client()
    if not token or not cid:
        return None
    if time.time() < token.get("expires_at", 0):
        return token["access_token"]
    fresh = post_form("https://oauth2.googleapis.com/token", {
        "client_id": cid, "client_secret": secret,
        "refresh_token": token["refresh_token"], "grant_type": "refresh_token",
    })
    fresh.setdefault("refresh_token", token["refresh_token"])
    fresh["expires_at"] = time.time() + fresh.get("expires_in", 3600) - 60
    write_private(TOKEN_FILE, fresh)
    return fresh["access_token"]


def api(path, **params):
    token = access_token()
    url = f"{API}{path}" + ("?" + urllib.parse.urlencode(params) if params else "")
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


# ── calendars ─────────────────────────────────────────────────────────────

def prefs():
    return read_json(PREFS_FILE, {}) or {}


def fetch_calendars():
    cached = read_cache("gcal-calendars.json", 3600)
    if cached is not None:
        return cached
    calendars, page = [], None
    while True:
        params = {"maxResults": 250}
        if page:
            params["pageToken"] = page
        data = api("/users/me/calendarList", **params)
        for item in data.get("items", []):
            calendars.append({
                "id": item["id"],
                "name": item.get("summaryOverride") or item.get("summary", item["id"]),
                "color": item.get("backgroundColor", "#4285f4"),
                "owned": item.get("accessRole") == "owner",
                "primary": item.get("primary", False),
                "googleSelected": item.get("selected", False),
            })
        page = data.get("nextPageToken")
        if not page:
            break
    calendars.sort(key=lambda c: (not c["primary"], not c["owned"], c["name"].lower()))
    write_cache("gcal-calendars.json", calendars)
    return calendars


def shown(calendar, chosen):
    # Until you pick, Omabar shows what Google Calendar itself shows.
    if calendar["id"] in chosen:
        return chosen[calendar["id"]]
    return calendar["googleSelected"] or calendar["primary"]


def signed_in():
    """Whether the optional Google API login works right now. A login that has
    stopped working must not take the linked calendars down with it."""
    try:
        return bool(access_token())
    except (urllib.error.URLError, OSError, KeyError, ValueError):
        return False


def all_calendars():
    """Google API calendars (when signed in) and linked iCal calendars."""
    calendars = []
    if signed_in():
        try:
            calendars += fetch_calendars()
        except (urllib.error.URLError, OSError, KeyError, ValueError):
            pass
    for c in linked():
        calendars.append({"id": c["id"], "name": c["name"], "color": c.get("color", PALETTE[0]),
                          "owned": c.get("owned", True), "primary": False, "googleSelected": True,
                          "ical": True})
    return calendars


def is_connected():
    return bool(linked()) or bool(read_json(TOKEN_FILE) and client()[0])


def cmd_calendars():
    if not is_connected():
        print(json.dumps({"connected": False, "calendars": []}))
        return 0
    chosen = prefs().get("shown", {})
    calendars = all_calendars()
    for calendar in calendars:
        calendar["shown"] = shown(calendar, chosen)
    print(json.dumps({"connected": True, "calendars": calendars}))
    return 0


def cmd_toggle(calendar_id):
    data = prefs()
    chosen = data.setdefault("shown", {})
    calendars = all_calendars()
    match = next((c for c in calendars if c["id"] == calendar_id), None)
    current = shown(match, chosen) if match else chosen.get(calendar_id, False)
    chosen[calendar_id] = not current
    write_private(PREFS_FILE, data)
    clear_cache("gcal-events")
    print(json.dumps({"id": calendar_id, "shown": chosen[calendar_id]}))
    return 0


# ── events ────────────────────────────────────────────────────────────────

def event_colors():
    cached = read_cache("gcal-colors.json", 86400)
    if cached is not None:
        return cached
    colors = {k: v["background"] for k, v in api("/colors").get("event", {}).items()}
    write_cache("gcal-colors.json", colors)
    return colors


def linked_events(calendar, start, end, tz):
    """(events, problem) for one linked calendar."""
    text, problem = feed(calendar)
    if text is None:
        return [], problem
    events = []
    for item in ical.expand_events(ical.read_calendar(text), start, end, tz):
        day = item["start"].value
        events.append({
            "title": item["title"],
            "start": ical.iso(item["start"], tz),
            "end": ical.iso(item["end"], tz),
            "allDay": item["start"].all_day,
            "location": item["location"],
            "calendar": calendar["name"],
            "color": calendar.get("color", PALETTE[0]),
            "link": f"https://calendar.google.com/calendar/r/day/{day.year}/{day.month}/{day.day}",
        })
    return events, problem


def cmd_events(month=None):
    if not is_connected():
        print(json.dumps({"connected": False, "events": []}))
        return 0
    tz = local_zone()
    now = dt.datetime.now(tz)
    if month and re.fullmatch(r"\d{4}-(0[1-9]|1[0-2])", month):
        year, mon = map(int, month.split("-"))
    else:
        year, mon = now.year, now.month
    month_start = dt.datetime(year, mon, 1, tzinfo=tz)
    month_end = dt.datetime(year + (mon == 12), mon % 12 + 1, 1, tzinfo=tz)
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)
    # The month grid also shows the last days of the month before and the
    # first of the month after, and today's agenda is always within reach.
    start = min(month_start - dt.timedelta(days=7), today)
    end = max(month_end + dt.timedelta(days=14), today + dt.timedelta(days=15))

    key = f"gcal-events-{start:%Y%m%d}-{end:%Y%m%d}.json"
    cached = read_cache(key, CACHE_SECONDS)
    if cached is not None:
        print(json.dumps({"connected": True, "events": cached}))
        return 0

    chosen = prefs().get("shown", {})
    events, problems = [], []
    wanted = [c for c in linked()
              if shown({"id": c["id"], "googleSelected": True, "primary": False}, chosen)]

    def load(calendar):
        try:
            return linked_events(calendar, start, end, tz)
        except Exception as error:  # one unreadable calendar must not hide the others
            return [], f"couldn't be read ({type(error).__name__})."

    if wanted:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(6, len(wanted))) as pool:
            for calendar, (found, problem) in zip(wanted, pool.map(load, wanted)):
                events += found
                if problem:
                    problems.append(f"{calendar['name']}: {problem}")

    api_calendars, palette = [], {}
    try:
        if access_token():
            api_calendars, palette = fetch_calendars(), event_colors()
    except urllib.error.HTTPError as error:
        problems.append("Google account: " + google_error(error))
    except (urllib.error.URLError, OSError, KeyError, ValueError):
        problems.append("Google account: couldn't reach Google.")
    for calendar in api_calendars:
        if not shown(calendar, chosen):
            continue
        try:
            data = api(f"/calendars/{urllib.parse.quote(calendar['id'])}/events",
                       timeMin=start.isoformat(), timeMax=end.isoformat(),
                       singleEvents="true", orderBy="startTime", maxResults=250)
        except (urllib.error.URLError, OSError, ValueError):
            problems.append(f"{calendar['name']}: couldn't be read.")
            continue
        for item in data.get("items", []):
            if item.get("status") == "cancelled":
                continue
            begins, ends = item.get("start", {}), item.get("end", {})
            all_day = "date" in begins
            events.append({
                "title": item.get("summary", "(No title)"),
                "start": begins.get("date") or begins.get("dateTime"),
                "end": ends.get("date") or ends.get("dateTime"),
                "allDay": all_day,
                "location": item.get("location", ""),
                "calendar": calendar["name"],
                "color": palette.get(item.get("colorId", ""), calendar["color"]),
                "link": item.get("htmlLink", ""),
            })
    events.sort(key=lambda e: (e["start"] or "", not e["allDay"]))
    if problems:
        print(json.dumps({"connected": True, "events": events, "error": " ".join(problems)}))
        return 0
    write_cache(key, events)
    print(json.dumps({"connected": True, "events": events}))
    return 0


def cmd_status():
    parts = []
    if read_json(TOKEN_FILE) and client()[0]:
        parts.append("Google account")
    if linked():
        parts.append(f"{len(linked())} linked calendar{'s' if len(linked()) != 1 else ''}")
    print("connected: " + ", ".join(parts) if parts else "not connected")
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    command, rest = argv[1], argv[2:]
    if command == "login":
        try:
            return cmd_login()
        except (urllib.error.URLError, OSError, ValueError) as error:
            print(f"Sign-in failed: {error}")
            return 1
    if command == "connect":
        return cmd_connect()
    if command == "disconnect":
        return cmd_disconnect()
    if command == "toggle" and len(rest) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        if command == "calendars":
            return cmd_calendars()
        if command == "toggle" and len(rest) == 1:
            return cmd_toggle(rest[0])
        if command == "events":
            return cmd_events(rest[0] if rest else None)
        if command == "status":
            return cmd_status()
    except urllib.error.HTTPError as error:
        print(json.dumps({"connected": True, "error": google_error(error), "events": [], "calendars": []}))
        return 0
    except (urllib.error.URLError, OSError, KeyError, ValueError, TypeError, AttributeError) as error:
        print(json.dumps({"connected": True, "error": str(error), "events": [], "calendars": []}))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
