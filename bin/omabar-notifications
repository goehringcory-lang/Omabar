#!/bin/bash
# Omabar notification button: a bell, crossed out while Do Not Disturb is on.
# Click: replay recent notifications. Right-click: toggle Do Not Disturb.

case "${1:-status}" in
  status)
    if [[ $(omarchy-shell -q notifications isDnd 2>/dev/null) == "on" ]]; then
      printf '%s\n' '{"text":"󰂛","tooltip":"Do not disturb is on\nRight-click to turn it off","class":"dnd"}'
    else
      printf '%s\n' '{"text":"󰂚","tooltip":"Notifications\nClick: show recent · Right-click: do not disturb","class":"normal"}'
    fi
    ;;
  history) omarchy-shell -q notifications showHistory >/dev/null ;;
  dnd) omarchy-shell -q notifications toggleDnd >/dev/null ;;
esac
