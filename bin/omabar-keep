#!/usr/bin/env python3
"""Omabar's Google Keep helper: your pinned notes and lists in the drawer.

    omabar-keep connect
        One-time setup in a terminal. Google has no Keep API for personal
        Gmail accounts, so this signs in the way Keep's Android app does. A
        browser window opens on Google's sign-in page; sign in and click
        "I agree", and the rest happens on its own: the one-time sign-in
        code Google hands the browser is traded for a Keep token, stored in
        your keyring, and the window closes. It uses a fresh, throwaway
        browser profile (Chromium, Chrome, Brave, Vivaldi or Edge), deleted
        afterwards.
    omabar-keep connect --paste
        The manual way, for Firefox or if the window above won't sign in:
        copy the oauth_token cookie from the browser's developer tools and
        paste it.
    omabar-keep disconnect
        Forget the account: removes the token from your keyring and the
        cached notes.
    omabar-keep status
        Print whether an account is connected, as JSON.
    omabar-keep cached
        Print the pinned notes from the last sync, as JSON (instant).
    omabar-keep pinned
        Sync with Google Keep and print your pinned notes and lists, as JSON.
    omabar-keep edit '<json>'
        Queue one change to a pinned note and print the notes with it
        applied. The next `pinned` sends it to Keep. Changes:
          {"op": "check", "note": id, "item": id, "checked": true}
          {"op": "itemText", "note": id, "item": id, "before": s, "after": s}
          {"op": "addItem", "note": id, "text": s}
          {"op": "deleteItem", "note": id, "item": id}
          {"op": "noteText", "note": id, "before": s, "after": s}
          {"op": "title", "note": id, "before": s, "after": s}
        A text change is only made if the text in Keep is still what you
        saw ("before"); if someone changed it meanwhile, Keep's version is
        kept and the conflict is reported.
    omabar-keep dismiss
        Clear the conflict messages the card shows.
    omabar-keep open [url]
        Open Google Keep (or one note) in your browser.

The token lives only in your keyring (GNOME Keyring, through secret-tool),
never in a file. ~/.config/omabar/keep.json holds just your email address and
this computer's device id. Synced notes are cached in ~/.cache/omabar/,
readable only by you. The Keep library (gkeepapi) is installed into its own
environment in ~/.local/share/omabar/keep-venv the first time you connect.
"""
import base64
import contextlib
import fcntl
import getpass
import json
import os
import re
import secrets
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

sys.dont_write_bytecode = True  # keep the plugin checkout clean

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "omabar")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "omabar")
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "omabar")
ACCOUNT_FILE = os.path.join(CONFIG_DIR, "keep.json")
STATE_FILE = os.path.join(CACHE_DIR, "keep-state.json")     # gkeepapi's own dump, for quick syncs
PINNED_FILE = os.path.join(CACHE_DIR, "keep-pinned.json")   # the last answer the bar got
LOCK_FILE = os.path.join(CACHE_DIR, "keep.lock")
PENDING_FILE = os.path.join(CACHE_DIR, "keep-pending.json")  # edits not yet in Keep, and conflicts
PENDING_LOCK = os.path.join(CACHE_DIR, "keep-pending.lock")
VENV = os.environ.get("OMABAR_KEEP_VENV") or os.path.join(DATA_DIR, "keep-venv")
# Known to work together (2026-11). gpsoauth 2+ drops the urllib3<2 pin.
REQUIREMENTS = ["gkeepapi==0.17.1", "gpsoauth==3.0.1"]

KEEP_URL = "https://keep.google.com/"
SETUP_URL = os.environ.get("OMABAR_KEEP_SETUP_URL") or "https://accounts.google.com/EmbeddedSetup"
# Browsers that can be watched over the Chrome DevTools Protocol, first found wins.
BROWSERS = ["chromium", "google-chrome-stable", "google-chrome", "brave", "brave-browser",
            "vivaldi-stable", "vivaldi", "microsoft-edge-stable", "helium-browser"]
SIGNIN_SECONDS = 600       # time to sign in (two-step codes, a phone prompt)
SECRET_ATTRS = ["service", "omabar-keep"]
SYNC_SECONDS = 45          # Google can hang a request; never leave the bar waiting
MAX_ITEMS = 400            # list items sent per note
MAX_TEXT = 20000           # characters of a note's text; longer notes are read-only here
OPS = {"check", "itemText", "addItem", "deleteItem", "noteText", "title"}


# ── storage ───────────────────────────────────────────────────────────────

def read_json(path, fallback=None):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_private(path, data):
    """JSON readable only by you, replaced in one step so a reader never sees
    half of it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    partial = f"{path}.{os.getpid()}.tmp"
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(data, handle)
    os.replace(partial, path)


def remove(path):
    with contextlib.suppress(OSError):
        os.remove(path)


def account():
    data = read_json(ACCOUNT_FILE, {})
    return data if isinstance(data, dict) and data.get("email") else None


# ── keyring ───────────────────────────────────────────────────────────────

def secret_tool():
    return shutil.which("secret-tool")


def keyring_attrs(email):
    return SECRET_ATTRS + ["account", email]


def keyring_store(email, token):
    tool = secret_tool()
    if not tool:
        raise RuntimeError("secret-tool is missing. Install it with: sudo pacman -S --needed libsecret gnome-keyring")
    result = subprocess.run([tool, "store", "--label", f"Omabar Google Keep ({email})"] + keyring_attrs(email),
                            input=token, text=True, capture_output=True, timeout=60)
    if result.returncode != 0:
        raise RuntimeError("Your keyring didn't take the token: " + (result.stderr.strip() or "no keyring is running")
                           + ". Is gnome-keyring running and unlocked?")


def keyring_lookup(email):
    tool = secret_tool()
    if not tool:
        return ""
    try:
        result = subprocess.run([tool, "lookup"] + keyring_attrs(email), capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def keyring_clear(email):
    tool = secret_tool()
    if tool:
        subprocess.run([tool, "clear"] + keyring_attrs(email), capture_output=True, timeout=20)


# ── the Keep library's own environment ────────────────────────────────────

def venv_python():
    return os.path.join(VENV, "bin", "python")


def venv_ready():
    python = venv_python()
    if not os.access(python, os.X_OK):
        return False
    probe = subprocess.run([python, "-I", "-c", "import gkeepapi, gpsoauth"], capture_output=True, timeout=60)
    return probe.returncode == 0


def ensure_venv(quiet=False):
    if venv_ready():
        return
    say = (lambda *_: None) if quiet else print
    say("Installing the Google Keep library (gkeepapi) for Omabar…")
    subprocess.run([sys.executable, "-m", "venv", "--clear", VENV], check=True)
    pip = [venv_python(), "-I", "-m", "pip", "install", "--disable-pip-version-check", "--quiet"]
    subprocess.run(pip + ["--upgrade", "pip"], check=False)
    subprocess.run(pip + REQUIREMENTS, check=True)
    if not venv_ready():
        raise RuntimeError("the Keep library didn't install; see the messages above")


def run_worker(task, payload, timeout=SYNC_SECONDS + 15):
    """Run one Keep task with the library's Python. The token goes in on
    stdin, so it never shows in the process list."""
    script = os.path.realpath(__file__)
    try:
        result = subprocess.run([venv_python(), "-I", script, "_worker", task], input=json.dumps(payload),
                                capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"error": "Google Keep didn't answer in time."}
    try:
        return json.loads(result.stdout)
    except ValueError:
        tail = (result.stderr or "").strip().splitlines()
        return {"error": "Keep sync failed" + (": " + tail[-1] if tail else ".")}


# ── worker (runs inside the venv) ─────────────────────────────────────────

def shape_note(node, max_items=MAX_ITEMS, max_text=MAX_TEXT):
    """A pinned note or list as the bar draws it."""
    kind = getattr(getattr(node, "type", None), "value", "NOTE")
    note = {
        "id": str(node.id),
        "kind": "list" if kind == "LIST" else "note",
        "title": str(node.title or ""),
        "color": str(getattr(node.color, "value", node.color) or "DEFAULT"),
        "url": KEEP_URL + "#" + ("LIST" if kind == "LIST" else "NOTE") + "/" + str(node.server_id or node.id),
        "labels": sorted(str(label.name) for label in node.labels.all()) if hasattr(node, "labels") else [],
    }
    if note["kind"] == "list":
        items = [item for item in node.items if not item.deleted and not item.trashed]
        unchecked = [item for item in items if not item.checked]
        checked = [item for item in items if item.checked]
        note["items"] = [{"id": str(item.id), "text": str(item.text or ""), "checked": bool(item.checked),
                          "indented": bool(item.indented)}
                         for item in (unchecked + checked)[:max_items]]
        note["unchecked"] = len(unchecked)
        note["checked"] = len(checked)
    else:
        text = str(node.text or "")
        note["text"] = text if len(text) <= max_text else text[:max_text].rstrip() + "…"
        note["readOnly"] = len(text) > max_text
    return note


def pinned_notes(keep):
    nodes = [node for node in keep.find(pinned=True, archived=False, trashed=False) if not node.deleted]
    # Keep shows pinned notes highest sort value first.
    nodes.sort(key=lambda node: int(getattr(node, "sort", 0) or 0), reverse=True)
    return [shape_note(node) for node in nodes]


def quoted(text, limit=40):
    text = " ".join(str(text or "").split())
    return "\u201c" + (text if len(text) <= limit else text[:limit - 1] + "\u2026") + "\u201d"


def apply_ops(keep, ops, ids):
    """Make queued edits on Keep's current notes. ids maps the bar's
    stand-in ids for new items to the ones Keep gave them, and grows as
    items are added. Returns (done op ids, conflicts)."""
    from gkeepapi.node import NewListItemPlacementValue
    done, conflicts = [], []

    def conflict(op, message):
        conflicts.append({"id": op.get("id", ""), "message": message})

    for op in ops:
        kind = op.get("op")
        note = keep.get(str(op.get("note", "")))
        if note is None or note.deleted or note.trashed:
            conflict(op, "A note you changed was deleted in Keep, so that change was dropped.")
            continue
        name = quoted(note.title) if note.title else "a note"
        item = None
        if "item" in op:
            item_id = ids.get(op["item"], op["item"])
            item = note.get(item_id) if hasattr(note, "get") else None
            if item is not None and (item.deleted or item.trashed):
                item = None
        if kind == "check":
            if item is None:
                conflict(op, f"An item in {name} was removed in Keep before your tick reached it.")
                continue
            item.checked = bool(op.get("checked"))
        elif kind == "itemText":
            if item is None:
                conflict(op, f"{quoted(op.get('before'))} in {name} was removed in Keep, so your edit was dropped.")
                continue
            now, before, after = str(item.text or ""), str(op.get("before", "")), str(op.get("after", ""))
            if now not in (before, after):
                conflict(op, f"{quoted(before)} in {name} was changed in Keep to {quoted(now)}. Keep's version was kept.")
                continue
            item.text = after
        elif kind == "addItem":
            if not hasattr(note, "add") or getattr(getattr(note, "type", None), "value", "") != "LIST":
                conflict(op, f"{name} isn't a list any more, so {quoted(op.get('text'))} wasn't added.")
                continue
            text = str(op.get("text", ""))
            # A send that reached Keep but whose answer got lost: the item is
            # already there, so don't add it twice.
            already = [existing for existing in note.items if str(existing.text or "") == text
                       and existing.timestamps.created and existing.timestamps.created.timestamp() >= float(op.get("at", 0)) - 5]
            new = already[0] if already else note.add(text, False, NewListItemPlacementValue.Bottom)
            if op.get("local"):
                ids[op["local"]] = str(new.id)
        elif kind == "deleteItem":
            if item is not None:
                item.delete()
        elif kind in ("noteText", "title"):
            field = "text" if kind == "noteText" else "title"
            now, before, after = str(getattr(note, field) or ""), str(op.get("before", "")), str(op.get("after", ""))
            if now not in (before, after):
                what = "text" if field == "text" else "title"
                conflict(op, f"The {what} of {name} was changed in Keep while you edited it. Keep's version was kept.")
                continue
            setattr(note, field, after)
        else:
            conflict(op, f"Unknown change {kind!r} skipped.")
            continue
        done.append(op.get("id", ""))
    return done, conflicts


def worker(task):
    payload = json.load(sys.stdin)
    out = {}

    def expire(*_):
        raise TimeoutError("Google Keep didn't answer in time.")

    signal.signal(signal.SIGALRM, expire)
    signal.alarm(SYNC_SECONDS)
    try:
        if task == "exchange":
            import gpsoauth
            answer = gpsoauth.exchange_token(payload["email"], payload["oauth_token"], payload["device"])
            token = answer.get("Token", "")
            if token:
                out = {"token": token, "email": str(answer.get("Email") or "")}
            else:
                detail = answer.get("ErrorDetail") or answer.get("Error") or "no token came back"
                out = {"error": f"Google turned the cookie down ({detail}). Cookies work once and only for a few minutes; get a fresh one and try again."}
        elif task == "sync":
            import gkeepapi
            keep = gkeepapi.Keep()
            state = read_json(STATE_FILE)
            try:
                keep.authenticate(payload["email"], payload["token"], state=state if isinstance(state, dict) else None,
                                  device_id=payload["device"])
            except gkeepapi.exception.LoginException as error:
                out = {"error": f"Google signed Omabar out of Keep ({error}). Run omabar-keep connect again.", "signedOut": True}
            else:
                ops = payload.get("ops") or []
                ids = dict(payload.get("ids") or {})
                done, conflicts = apply_ops(keep, ops, ids) if ops else ([], [])
                if done:
                    keep.sync()   # send the edits; raises (and nothing is marked done) if Keep refuses
                write_private(STATE_FILE, keep.dump())
                out = {"notes": pinned_notes(keep), "done": done, "conflicts": conflicts, "ids": ids}
        else:
            out = {"error": f"unknown task {task}"}
    except TimeoutError as error:
        out = {"error": str(error)}
    except Exception as error:  # noqa: BLE001 - the bar shows any failure as a message
        offline = any(cls.__name__ in ("ConnectionError", "ProxyError", "Timeout", "SSLError")
                      for cls in type(error).__mro__)
        out = {"error": "Can't reach Google Keep. Are you online?" if offline
               else f"Keep sync failed: {type(error).__name__}: {error}"[:300]}
    finally:
        signal.alarm(0)
    print(json.dumps(out))


# ── one-click sign-in: watch a throwaway browser for Google's code ───────

class DevTools:
    """Just enough of a WebSocket client to talk to a browser's DevTools
    endpoint on this computer (no extra packages)."""

    def __init__(self, url, timeout=15):
        parts = urllib.parse.urlparse(url)
        self.sock = socket.create_connection((parts.hostname, parts.port), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {parts.path} HTTP/1.1\r\nHost: {parts.hostname}:{parts.port}\r\n"
                           f"Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise OSError("the browser closed the connection")
            head += chunk
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise OSError("the browser refused the connection")
        self.buffer = head.split(b"\r\n\r\n", 1)[1]
        self.next_id = 0

    def close(self):
        with contextlib.suppress(OSError):
            self.sock.close()

    def _read(self, count):
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise OSError("the browser closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def _send(self, opcode, payload):
        mask = os.urandom(4)
        size = len(payload)
        if size < 126:
            header = struct.pack("!BB", 0x80 | opcode, 0x80 | size)
        elif size < 65536:
            header = struct.pack("!BBH", 0x80 | opcode, 0x80 | 126, size)
        else:
            header = struct.pack("!BBQ", 0x80 | opcode, 0x80 | 127, size)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(header + mask + masked)

    def _message(self):
        parts = []
        while True:
            first, second = self._read(2)
            size = second & 0x7F
            if size == 126:
                size = struct.unpack("!H", self._read(2))[0]
            elif size == 127:
                size = struct.unpack("!Q", self._read(8))[0]
            mask = self._read(4) if second & 0x80 else b""
            payload = self._read(size)
            if mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            opcode = first & 0x0F
            if opcode == 8:
                raise OSError("the browser closed the connection")
            if opcode == 9:
                self._send(10, payload)
                continue
            if opcode in (0, 1, 2):
                parts.append(payload)
                if first & 0x80:
                    return json.loads(b"".join(parts).decode("utf-8", "replace"))

    def call(self, method, params=None):
        self.next_id += 1
        ask = self.next_id
        self._send(1, json.dumps({"id": ask, "method": method, "params": params or {}}).encode())
        while True:
            message = self._message()
            if message.get("id") == ask:
                if "error" in message:
                    raise OSError(message["error"].get("message", "DevTools error"))
                return message.get("result", {})


def find_browser():
    chosen = os.environ.get("OMABAR_KEEP_BROWSER")
    if chosen:
        return shutil.which(chosen)
    for name in BROWSERS:
        path = shutil.which(name)
        if path:
            return path
    return None


def free_port():
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


# Straight to the browser on this computer, never through a proxy.
LOCAL = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def devtools_json(port, path):
    with LOCAL.open(f"http://127.0.0.1:{port}{path}", timeout=3) as answer:
        return json.load(answer)


def signin_cookie(cookies, host):
    """The oauth_token Google sets on its sign-in site once you click I agree."""
    for cookie in cookies:
        domain = str(cookie.get("domain", "")).lstrip(".")
        if cookie.get("name") == "oauth_token" and cookie.get("value") and (host == domain or host.endswith("." + domain)):
            return str(cookie["value"])
    return ""


def signed_in_email(port, host):
    """The account signed in to the throwaway browser, read the way Chromium
    itself lists its Google accounts. "" when it can't be told."""
    try:
        pages = [page for page in devtools_json(port, "/json/list")
                 if page.get("type") == "page" and host in str(page.get("url", ""))]
        if not pages:
            return ""
        page = DevTools(pages[0]["webSocketDebuggerUrl"])
        try:
            result = page.call("Runtime.evaluate", {
                "expression": "fetch('/ListAccounts?gpsia=1&source=ChromiumBrowser&json=standard',"
                              "{credentials:'include'}).then(r => r.text())",
                "awaitPromise": True, "returnByValue": True})
        finally:
            page.close()
        text = str(result.get("result", {}).get("value", ""))
    except (OSError, ValueError, KeyError):
        return ""
    found = re.findall(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", text)
    return found[0] if found else ""


def browser_signin(say=print, timeout=SIGNIN_SECONDS):
    """Open Google's sign-in page in a fresh browser profile and wait for the
    one-time code it hands the browser. Returns (code, email, why-not)."""
    browser = find_browser()
    if not browser:
        return "", "", "no Chromium-family browser was found"
    host = urllib.parse.urlparse(SETUP_URL).hostname or "accounts.google.com"
    profile = tempfile.mkdtemp(prefix="omabar-keep-")
    port = free_port()
    command = [browser, f"--user-data-dir={profile}", f"--remote-debugging-port={port}",
               "--no-first-run", "--no-default-browser-check", "--disable-sync", "--new-window",
               "--window-size=560,760"] + os.environ.get("OMABAR_KEEP_BROWSER_FLAGS", "").split() + [SETUP_URL]
    process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    devtools = None
    try:
        deadline = time.time() + 30
        while devtools is None:
            if process.poll() is not None:
                return "", "", "the browser closed before it opened Google's page (is it already running with this profile?)"
            try:
                devtools = DevTools(devtools_json(port, "/json/version")["webSocketDebuggerUrl"])
            except (OSError, ValueError, KeyError):
                if time.time() > deadline:
                    return "", "", "the browser didn't open its DevTools port"
                time.sleep(0.4)
        say("Waiting for you to sign in…")
        deadline = time.time() + timeout
        while time.time() < deadline:
            if process.poll() is not None:
                return "", "", "the browser window was closed before sign-in finished"
            try:
                code = signin_cookie(devtools.call("Storage.getCookies").get("cookies", []), host)
            except OSError:
                return "", "", "the browser window was closed before sign-in finished"
            if code:
                return code, signed_in_email(port, host), ""
            time.sleep(0.8)
        return "", "", "sign-in took longer than 10 minutes"
    finally:
        if devtools:
            with contextlib.suppress(OSError):
                devtools.call("Browser.close")
            devtools.close()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=5)
        # The throwaway profile held your Google sign-in: it goes.
        shutil.rmtree(profile, ignore_errors=True)


# ── commands ──────────────────────────────────────────────────────────────

def emit(data):
    print(json.dumps(data))


@contextlib.contextmanager
def pending_lock():
    """Guards the queue of edits, separately from syncing, so a tick made
    while a sync runs is queued straight away."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(PENDING_LOCK, "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def read_pending():
    data = read_json(PENDING_FILE, {})
    if not isinstance(data, dict):
        data = {}
    data.setdefault("ops", [])
    data.setdefault("ids", {})
    data.setdefault("conflicts", [])
    return data


def overlay(notes, pending):
    """The notes as they'll be once queued edits reach Keep, so the card
    shows a tick or new item the moment you make it."""
    notes = json.loads(json.dumps(notes or []))
    ids = pending.get("ids", {})
    by_id = {note.get("id"): note for note in notes}
    for op in pending.get("ops", []):
        note = by_id.get(op.get("note"))
        if not note:
            continue
        items = note.get("items") if isinstance(note.get("items"), list) else None
        wanted = op.get("item")
        item = None
        if items is not None and wanted:
            for candidate in items:
                if candidate.get("id") in (wanted, ids.get(wanted)):
                    item = candidate
                    break
        kind = op.get("op")
        if kind == "check" and item:
            item["checked"] = bool(op.get("checked"))
        elif kind == "itemText" and item:
            item["text"] = str(op.get("after", ""))
        elif kind == "addItem" and items is not None:
            if not any(candidate.get("id") in (op.get("local"), ids.get(op.get("local"))) for candidate in items):
                items.append({"id": op.get("local", ""), "text": str(op.get("text", "")), "checked": False,
                              "indented": False, "local": True})
        elif kind == "deleteItem" and item and items is not None:
            items.remove(item)
        elif kind == "noteText":
            note["text"] = str(op.get("after", ""))
        elif kind == "title":
            note["title"] = str(op.get("after", ""))
    for note in notes:
        if isinstance(note.get("items"), list):
            open_items = [item for item in note["items"] if not item.get("checked")]
            done_items = [item for item in note["items"] if item.get("checked")]
            note["items"] = open_items + done_items
            note["unchecked"], note["checked"] = len(open_items), len(done_items)
    return notes


def answer_with(base, pending=None):
    """What the card gets: the notes with queued edits applied, how many
    edits are still waiting, and any conflicts to show."""
    pending = pending if pending is not None else read_pending()
    data = dict(base)
    data["notes"] = overlay(base.get("notes", []), pending)
    data["pending"] = len(pending["ops"])
    data["conflicts"] = pending["conflicts"]
    return data


def cmd_status():
    info = account()
    emit({"connected": bool(info and keyring_lookup(info["email"])), "email": info["email"] if info else "",
          "pending": len(read_pending()["ops"])})


def cached_base():
    info = account()
    cached = read_json(PINNED_FILE)
    if not info or not isinstance(cached, dict):
        return {"connected": bool(info), "notes": [], "synced": 0}
    cached["connected"] = True
    return cached


def cmd_cached():
    data = answer_with(cached_base())
    data["cached"] = True
    emit(data)


def validate_op(op):
    if not isinstance(op, dict) or op.get("op") not in OPS or not op.get("note"):
        return None
    clean = {key: op[key] for key in ("op", "note", "item", "before", "after", "text", "checked") if key in op}
    for key in ("note", "item", "before", "after", "text"):
        if key in clean:
            clean[key] = str(clean[key])
    if clean["op"] in ("check", "itemText", "deleteItem") and not clean.get("item"):
        return None
    if clean["op"] == "addItem" and not clean.get("text", "").strip():
        return None
    clean["id"] = secrets.token_hex(6)
    clean["at"] = time.time()
    if clean["op"] == "addItem":
        clean["local"] = "local:" + clean["id"]
    return clean


def cmd_edit(raw):
    try:
        op = validate_op(json.loads(raw))
    except ValueError:
        op = None
    if op is None:
        emit({"error": "That change couldn't be read."})
        sys.exit(1)
    with pending_lock():
        pending = read_pending()
        ops = pending["ops"]
        # Typing the same field again replaces the queued edit rather than
        # stacking them, keeping the first "before" for the conflict check.
        if op["op"] in ("itemText", "noteText", "title"):
            for queued in ops:
                if queued.get("op") == op["op"] and queued.get("note") == op["note"] and queued.get("item") == op.get("item"):
                    queued["after"] = op["after"]
                    queued["at"] = op["at"]
                    op = None
                    break
        # A new item edited before it reached Keep: change the queued add.
        if op and op.get("item", "").startswith("local:"):
            for queued in ops:
                if queued.get("local") == op["item"]:
                    if op["op"] == "itemText":
                        queued["text"] = op["after"]
                        op = None
                    elif op["op"] == "deleteItem":
                        ops.remove(queued)
                        op = None
                    break
        if op:
            ops.append(op)
        write_private(PENDING_FILE, pending)
        emit(answer_with(cached_base(), pending))


def cmd_dismiss():
    with pending_lock():
        pending = read_pending()
        pending["conflicts"] = []
        write_private(PENDING_FILE, pending)
    emit(answer_with(cached_base()))


@contextlib.contextmanager
def sync_lock():
    """One sync at a time (two monitors' bars, a click while the first runs)."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(LOCK_FILE, "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def cmd_pinned():
    info = account()
    if not info:
        emit({"connected": False, "notes": [], "pending": 0, "conflicts": []})
        return
    token = keyring_lookup(info["email"])
    if not token:
        emit(answer_with({"connected": False, "notes": cached_base().get("notes", []),
                          "error": "No Keep token in your keyring. Run omabar-keep connect."}))
        return
    if not venv_ready():
        emit(answer_with({"connected": True, "notes": cached_base().get("notes", []),
                          "error": "The Keep library is missing. Run omabar-keep connect."}))
        return
    with sync_lock():
        with pending_lock():
            snapshot = read_pending()
        # Another bar may have just synced; its answer is good enough, unless
        # there are edits to send.
        recent = read_json(PINNED_FILE)
        if not snapshot["ops"] and isinstance(recent, dict) and 0 <= time.time() - recent.get("synced", 0) < 10:
            recent["connected"] = True
            emit(answer_with(recent, snapshot))
            return
        answer = run_worker("sync", {"email": info["email"], "token": token, "device": info["device"],
                                     "ops": snapshot["ops"], "ids": snapshot["ids"]})
        if "notes" in answer:
            data = {"notes": answer["notes"], "synced": time.time(), "email": info["email"]}
            write_private(PINNED_FILE, data)
            with pending_lock():
                pending = read_pending()
                finished = set(answer.get("done", [])) | {c.get("id") for c in answer.get("conflicts", [])}
                pending["ops"] = [op for op in pending["ops"] if op.get("id") not in finished]
                pending["ids"].update(answer.get("ids") or {})
                # Stand-ins no queued edit mentions any more can go.
                still = {op.get("item") for op in pending["ops"]} | {op.get("local") for op in pending["ops"]}
                pending["ids"] = {key: value for key, value in pending["ids"].items() if key in still}
                pending["conflicts"] = (pending["conflicts"] + answer.get("conflicts", []))[-10:]
                write_private(PENDING_FILE, pending)
                data["connected"] = True
                emit(answer_with(data, pending))
            return
    # Failed: show what we had, with the reason. Queued edits stay queued.
    base = cached_base()
    base["connected"] = not answer.get("signedOut")
    base["error"] = answer.get("error", "Keep sync failed.")
    emit(answer_with(base))


def open_url(url):
    for opener in (["omarchy-launch-browser", url], ["xdg-open", url]):
        if shutil.which(opener[0]):
            subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return False


def cmd_open(url=KEEP_URL):
    if not url.startswith(KEEP_URL):
        sys.exit("omabar-keep open: only Google Keep links")
    open_url(url)


def paste_code(email):
    """The manual way: the user copies the oauth_token cookie themselves."""
    print("\n1. Your browser is opening " + SETUP_URL)
    print("   Sign in" + (" with " + email if email else "") + " and click \"I agree\". The page may keep")
    print("   spinning after that; that's fine.")
    print("2. Open the developer tools (F12), then:")
    print("   Chromium/Chrome: Application > Cookies > https://accounts.google.com")
    print("   Firefox:         Storage > Cookies > https://accounts.google.com")
    print("3. Copy the value of the cookie named oauth_token (it starts with oauth2_4/).")
    print("   It works once and only for a few minutes, so paste it right away.\n")
    if not open_url(SETUP_URL):
        print("   (Open that address yourself.)")
    pasted = getpass.getpass("Paste oauth_token (hidden), or Enter to cancel: ").strip().strip('"')
    return urllib.parse.unquote(pasted)


def cmd_connect(manual=False):
    print("Omabar: connect Google Keep\n")
    print("Google has no Keep API for personal Gmail accounts, so Omabar signs in the")
    print("way Keep's Android app does. The Keep token it gets is kept in your keyring,")
    print("not in a file. Like a phone signed in to your account, it can read your")
    print("Google account; `omabar-keep disconnect` removes it, and changing your Google")
    print("password revokes it.\n")

    if not secret_tool():
        sys.exit("First install the keyring tools:  sudo pacman -S --needed libsecret gnome-keyring")
    try:
        ensure_venv()
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        sys.exit(f"Couldn't install the Keep library: {error}")

    previous = account() or {}
    email = ""
    code = ""
    if not manual and find_browser():
        print("A browser window is opening on Google's sign-in page. Sign in there and")
        print("click \"I agree\". That's all: this finishes and the window closes on its own.\n")
        code, email, why = browser_signin()
        if not code:
            print(f"\nThat didn't finish ({why}).")
            print("Falling back to the manual way.")
    elif not manual:
        print("No Chromium-family browser found, so this is the manual way.")

    while True:
        if not code:
            if not email:
                default = previous.get("email", "")
                email = input(f"Your Google account email{' [' + default + ']' if default else ''}: ").strip() or default
                if "@" not in email:
                    sys.exit("That doesn't look like an email address.")
            code = paste_code(email)
            if not code:
                sys.exit("Cancelled. Nothing was saved.")
        email = email or previous.get("email", "")
        device = previous.get("device") if previous.get("device") else secrets.token_hex(8)
        if code.startswith("aas_et/"):
            token = code  # already a Keep token (from another tool)
            break
        print("Signed in. Getting a Keep token…")
        answer = run_worker("exchange", {"email": email, "oauth_token": code, "device": device})
        if answer.get("token"):
            token = answer["token"]
            email = answer.get("email") or email
            break
        print(answer.get("error", "That didn't work.") + "\n")
        code = ""  # each code works once: get a new one

    if "@" not in email:
        email = input("Your Google account email: ").strip()
        if "@" not in email:
            sys.exit("That doesn't look like an email address. Nothing was saved.")

    print(f"Checking your pinned notes for {email}…")
    answer = run_worker("sync", {"email": email, "token": token, "device": device}, timeout=180)
    if "notes" not in answer:
        sys.exit(answer.get("error", "Keep didn't answer.") + "\nNothing was saved.")
    try:
        keyring_store(email, token)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
        sys.exit(str(error))
    if previous.get("email") and previous["email"] != email:
        keyring_clear(previous["email"])
    write_private(ACCOUNT_FILE, {"email": email, "device": device})
    write_private(PINNED_FILE, {"notes": answer["notes"], "synced": time.time(), "email": email})
    count = len(answer["notes"])
    print(f"\nConnected. {count} pinned note{'s' if count != 1 else ''} found.")
    print("Open the drawer on the bar and click Keep to see them.")


def cmd_disconnect():
    info = account()
    if info:
        keyring_clear(info["email"])
    for path in (ACCOUNT_FILE, STATE_FILE, PINNED_FILE, PENDING_FILE):
        remove(path)
    print("Google Keep disconnected. The token and cached notes are gone.")


def main(argv):
    command = argv[1] if len(argv) > 1 else "help"
    if command == "_worker":
        worker(argv[2])
    elif command == "status":
        cmd_status()
    elif command == "cached":
        cmd_cached()
    elif command == "pinned":
        cmd_pinned()
    elif command == "edit":
        cmd_edit(argv[2] if len(argv) > 2 else "")
    elif command == "dismiss":
        cmd_dismiss()
    elif command == "open":
        cmd_open(argv[2] if len(argv) > 2 else KEEP_URL)
    elif command == "connect":
        try:
            cmd_connect(manual="--paste" in argv[2:])
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled. Nothing was saved.")
            sys.exit(130)
    elif command == "disconnect":
        cmd_disconnect()
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv)
