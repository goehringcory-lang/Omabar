#!/bin/bash
# Switch the Omarchy shell to Omabar and lay out its widgets.
#
#   omabar-setup            use Omabar with its layout (backs up shell.json first)
#   omabar-setup --restore  put back the bar from before setup (other settings kept)
#   omabar-setup --uninstall
#                           remove Omabar completely: put back your old bar,
#                           delete Omabar's hook, settings, tokens and cache,
#                           then remove the plugin itself
#   omabar-setup --rebuild  rebuild the bar after an Omarchy update, layout untouched
#   omabar-setup --doctor   print what is installed and what the shell logged
#   omabar-setup --world-clock "City, Region=Zone" ...
#                           set the world clock's cities (kept through every setup)
#
# Layout
#   left    Omarchy menu (accent tile), workspace dots with a water-drop switch
#   center  quick indicators, Ask box, Spotify mini player, split-flap clock
#   (the world clock, restyled with split-flap times, omaplug, the plugin
#    manager, and weather sit just right of the clock)
#   right   the hover drawer handle (always leftmost), AI usage (Omarchy
#           agents, plus ai-usagebar when installed), notifications,
#           Thunderbird mail, Omarchy settings, and battery. The drawer holds every other plugin widget
#           you have installed (each one once), Omaland,
#           Bluetooth, Wi-Fi, audio, display and keyboard layout.

set -euo pipefail

PLUGIN_ID="goehringcory.omabar"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
PLUGIN_DIR="$PLUGINS_DIR/$PLUGIN_ID"
CONFIG_FILE="$HOME/.config/omarchy/shell.json"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_PATH
DEFAULTS_FILE="$OMARCHY_PATH/config/omarchy/shell.json"
ENGINE_DIR="$PLUGIN_DIR/engine"
BACKUP_FILE="$HOME/.config/omarchy/shell.json.before-omabar"
# Omarchy runs this after `omarchy update`; it rebuilds the bar for the new shell.
HOOK_FILE="$HOME/.config/omarchy/hooks/post-update.d/omabar-rebuild"

fail() {
  echo "omabar-setup: $*" >&2
  exit 1
}

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

# Omabar's own settings, tokens, cache and Focus mode state. --uninstall
# deletes all three.
OMABAR_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omabar"
OMABAR_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omabar"
OMABAR_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omabar"
# The world clock's cities, as `omabar-setup --world-clock` saved them last.
WORLD_CLOCK_FILE="$OMABAR_CONFIG_DIR/world-clock.json"
# The id of the world clock clone setup made, so --uninstall removes only
# a clone Omabar created and leaves one you made yourself.
ELSEWHEN_RECORD="$OMABAR_CONFIG_DIR/elsewhen-clone"
world_clock_override=""

case ${1:-} in
"" | --restore | --uninstall | --rebuild | --doctor) ;;
--world-clock)
  shift
  (($# > 0)) || fail 'name at least one city: --world-clock "Jonesborough, Tennessee=America/New_York"'
  world_clock_override="[]"
  for spec in "$@"; do
    [[ $spec == *=* ]] || fail "\"$spec\" needs a time zone after an =, like \"Moyogalpa, Nicaragua=America/Managua\""
    zone=${spec##*=}
    place=${spec%=*}
    [[ $zone =~ ^[A-Za-z0-9_+/-]+$ ]] || fail "\"$zone\" isn't a time zone name (see: timedatectl list-timezones)"
    [[ -e /usr/share/zoneinfo/$zone ]] || fail "no time zone called $zone (see: timedatectl list-timezones)"
    # Elsewhen keeps commas out of a city's name, so what follows the first
    # comma becomes its region.
    name=$(sed 's/,.*//; s/[|]/ /g; s/^ *//; s/ *$//' <<<"$place")
    region=""
    [[ $place == *,* ]] && region=$(sed 's/^[^,]*,//; s/^ *//; s/ *$//' <<<"$place")
    [[ -n $name ]] || fail "\"$spec\" needs a city name before the ="
    world_clock_override=$(jq -c --arg name "$name" --arg zone "$zone" --arg region "$region" \
      '. + [ { name: $name, zone: $zone } + (if $region == "" then {} else { region: $region } end) ]' \
      <<<"$world_clock_override")
  done
  set -- --world-clock
  ;;
-h | --help)
  usage
  exit 0
  ;;
*)
  usage >&2
  fail "unknown option: $1"
  ;;
esac
(($# <= 1)) || fail "takes one option at most"

# Whatever is half-made when the script stops, however it stops.
scratch=()
cleanup() {
  ((${#scratch[@]} == 0)) || rm -rf "${scratch[@]}"
}
trap cleanup EXIT

reload_shell() {
  # Quickshell serves plugin QML from what it read when it started, so a
  # rebuilt engine only takes effect after a full restart; reloading plugins
  # in place keeps showing the old file.
  echo "Restarting the Omarchy shell..."
  if command -v omarchy-restart-shell >/dev/null && omarchy-restart-shell >/dev/null 2>&1; then
    local _
    for _ in $(seq 1 60); do
      [[ $(omarchy-shell shell ping 2>/dev/null) == "ok" ]] && break
      sleep 0.25
    done
  else
    omarchy-shell -q shell reloadPlugins >/dev/null 2>&1 || true
    sleep 1
  fi
  omarchy-shell -q shell reloadConfig >/dev/null 2>&1 || true
}

shell_log() {
  journalctl -t omarchy-shell --no-pager "$@" 2>/dev/null || true
}

# Whether the running shell is drawing Omabar: "true", "false", or "" when the
# shell can't be asked.
omabar_active() {
  omarchy-shell shell listPlugins 2>/dev/null |
    jq -r --arg id "$PLUGIN_ID" '.[] | select(.id == $id) | .active' 2>/dev/null || true
}

# Omabar's bar engine is Omarchy's own bar with a glass body. Build it from the
# Omarchy installed here so it matches this shell; fall back to the copy made
# from Omarchy 4.5.0 if this Omarchy's bar has moved on from the edits.
build_engine() {
  local source_dir="$OMARCHY_PATH/shell/plugins/bar" staged stamp
  stamp="$(engine_stamp) built"
  staged=$(mktemp -d "$PLUGIN_DIR/.engine.XXXXXX")
  scratch+=("$staged")
  if [[ -f $source_dir/Bar.qml ]] && command -v python3 >/dev/null &&
    python3 "$PLUGIN_DIR/tools/omabar-patch.py" "$source_dir" "$staged" >/dev/null; then
    echo "Built the bar from your Omarchy ($(omarchy version 2>/dev/null || echo "version unknown"))"
  else
    echo "omabar-setup: could not build the bar from $source_dir; using the copy built for Omarchy 4.5.0" >&2
    cp "$PLUGIN_DIR/prebuilt/OmabarEngine.qml" "$PLUGIN_DIR/prebuilt/BarModel.js" "$staged/"
    stamp="$(engine_stamp) prebuilt"
  fi
  echo "$stamp" >"$staged/.built-from"
  rm -rf "$ENGINE_DIR"
  mv "$staged" "$ENGINE_DIR"
}

# What an engine is built from: Omarchy's bar and Omabar's edits to it. When
# either changes, the engine in place is stale.
engine_stamp() {
  cat "$OMARCHY_PATH/shell/plugins/bar/Bar.qml" "$OMARCHY_PATH/shell/plugins/bar/BarModel.js" \
    "$PLUGIN_DIR/tools/omabar-patch.py" 2>/dev/null | sha256sum | cut -d' ' -f1
}

# The stamp also says whether the engine was built here or is the 4.5.0 copy,
# used when the edits no longer fit. Either way it is the best there is for
# this Omarchy until one of the two changes again.
engine_current() {
  [[ -f $ENGINE_DIR/OmabarEngine.qml && -f $ENGINE_DIR/.built-from &&
    $(cut -d' ' -f1 "$ENGINE_DIR/.built-from") == "$(engine_stamp)" ]]
}

engine_state() {
  if ! engine_current; then
    echo "out of date, run: omabar-setup --rebuild"
  elif grep -q ' prebuilt$' "$ENGINE_DIR/.built-from"; then
    echo "the copy built for Omarchy 4.5.0 (Omabar's edits don't fit this Omarchy's bar, see patch check)"
  else
    echo "built from this Omarchy"
  fi
}

# Whether shell.json names Omabar as the bar.
omabar_selected() {
  [[ $(jq -r '.bar.id // ""' "$CONFIG_FILE" 2>/dev/null) == "$PLUGIN_ID" ]]
}

# Ask the shell whether it took Omabar. When a bar fails to load the shell
# quietly keeps the built-in one, so say so here instead.
check_loaded() {
  local started="$1" active="" _
  if [[ $(omarchy-shell shell ping 2>/dev/null) != "ok" ]]; then
    echo "Omabar is set up, but the Omarchy shell isn't answering, so it couldn't be checked. Start it with: omarchy restart shell"
    return 0
  fi
  # A shell that has only just started answers before it has found its
  # plugins, and then has nothing to say about Omabar yet.
  for _ in $(seq 1 20); do
    active=$(omabar_active)
    [[ -z $active ]] || break
    sleep 0.5
  done
  # The shell reports a bar as active the moment it starts loading it, and
  # only falls back once loading fails, so give it time and then check both
  # what it reports and what it logged.
  sleep 3
  active=$(omabar_active)
  if shell_log --since "$started" | grep -q -E "bar option $PLUGIN_ID failed to load"; then
    active="false"
  fi
  case $active in
  true)
    echo "Omabar is on. Undo any time with: $PLUGIN_DIR/bin/omabar-setup --restore"
    weather_tip
    ;;
  false)
    {
      echo "omabar-setup: the shell did not load Omabar and is showing the built-in bar instead."
      echo "What the shell logged:"
      shell_log --since "$started" | grep -i -E 'omabar|bar option|falling back|\.qml' | tail -n 40 || true
      echo "Send that, plus the output of: $PLUGIN_DIR/bin/omabar-setup --doctor"
      echo "Your old layout: $PLUGIN_DIR/bin/omabar-setup --restore"
    } >&2
    return 1
    ;;
  *)
    echo "Omabar is set up, but the shell didn't say whether it loaded. Check with: $PLUGIN_DIR/bin/omabar-setup --doctor"
    ;;
  esac
}

# Weather starts on the author's home (Yosemite Valley) until a location is set.
weather_tip() {
  local placed
  placed=$(jq -r '[ .bar.layout[]? | arrays | .[] | objects | select(.id == "omabar-weather") | select((.url // .lat // "") == "") ] | length' "$CONFIG_FILE" 2>/dev/null || echo 0)
  if [[ $placed != 0 ]]; then
    echo "Tip: weather shows Yosemite Valley until you set yours:"
    echo "  omarchy bar set omabar-weather url \"https://forecast.weather.gov/MapClick.php?lat=<lat>&lon=<lon>\""
  fi
}

doctor() {
  echo "== Omarchy"
  echo "version: $(omarchy version 2>&1 || true)"
  echo "OMARCHY_PATH: $OMARCHY_PATH"
  echo "quickshell: $( (qs --version || quickshell --version) 2>/dev/null | head -n1)"
  echo "shell: $(omarchy-shell shell ping 2>&1 || true)"
  echo "== Omabar"
  echo "revision: $(git -C "$PLUGIN_DIR" log -1 --format='%h %s' 2>&1 || true)"
  echo "local changes: $(git -C "$PLUGIN_DIR" status --porcelain 2>&1 | tr '\n' ' ')"
  echo "engine: $(ls "$ENGINE_DIR" 2>&1 | tr '\n' ' ')"
  echo "engine is: $(engine_state)"
  echo "update hook: $([[ -f $HOOK_FILE ]] && echo installed || echo missing)"
  echo "validate: $(omarchy plugin validate "$PLUGIN_DIR" 2>&1 && echo ok)"
  local check
  check=$(mktemp -d)
  scratch+=("$check")
  echo "patch check: $(python3 "$PLUGIN_DIR/tools/omabar-patch.py" "$OMARCHY_PATH/shell/plugins/bar" "$check" 2>&1 | tr '\n' ' ')"
  echo "active in shell: $(omabar_active)"
  echo "== shell.json"
  jq -c '.bar | {id, position, background, layout: ((.layout // {}) | map_values(map(.id)))}' "$CONFIG_FILE" 2>&1 || true
  echo "== world clock"
  jq -c '[ .bar.layout[]? | arrays | .[] | objects | select(.id | test("elsewhen")) | {id, cities, zones} ]' "$CONFIG_FILE" 2>&1 || true
  echo "saved copy: $(jq -c . "$WORLD_CLOCK_FILE" 2>/dev/null || echo none)"
  shell_log -b | grep -i -E 'elsewhen|updateEntryInline|persist' | tail -n 20 || true
  echo "== helpers"
  local tool
  for tool in jq python3 busctl wtype wl-copy dbus-monitor notify-send omarchy-notification-send; do
    printf '%s: %s\n' "$tool" "$(command -v "$tool" || echo missing)"
  done
  echo "manifest version: $(jq -r '.version // "?"' "$PLUGIN_DIR/manifest.json" 2>&1 || true)"
  echo "spotify: $("$PLUGIN_DIR/bin/omabar-spotify" status 2>&1 | head -c 300 || true)"
  echo "calendar: $("$PLUGIN_DIR/bin/omabar-gcal" status 2>&1 | head -c 300 || true)"
  echo "mail: $("$PLUGIN_DIR/bin/omabar-mail-unread" 2>&1 | head -c 300 || true)"
  echo "weather cache: $(ls "$OMABAR_CACHE_DIR" 2>/dev/null | grep -i weather | tr '\n' ' ' || true)"
  echo "== plugins"
  omarchy plugin list 2>&1 | grep -v -E '^omarchy\.' || true
  echo "== shell log (this boot)"
  shell_log -b | grep -i -E 'omabar|bar option|falling back|shell\.json|plugin' | tail -n 60 || true
}

# Put back the bar from before Omabar without touching anything else in
# shell.json: only the "bar" section comes from the backup, and every other
# setting you changed since setup stays as it is now. When the bar in use is
# no longer Omabar, you picked another one yourself, so it is left alone.
RESTORE_BAR_JQ='if ($before[0] | type) == "object" and ($before[0] | has("bar")) then .bar = $before[0].bar else del(.bar) end'
restore_bar() {
  if [[ ! -f $BACKUP_FILE ]]; then
    return 1
  fi
  if [[ -s $CONFIG_FILE ]] && jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1; then
    if ! omabar_selected; then
      rm -f "$BACKUP_FILE"
      echo "Your bar isn't Omabar any more, so it was left as it is"
      return 0
    fi
    jq -e 'type == "object"' "$BACKUP_FILE" >/dev/null 2>&1 ||
      fail "the backup at $BACKUP_FILE can't be read, so shell.json was left unchanged"
    local merged
    merged=$(mktemp "$CONFIG_FILE.XXXXXX")
    scratch+=("$merged")
    jq --slurpfile before "$BACKUP_FILE" "$RESTORE_BAR_JQ" "$CONFIG_FILE" >"$merged"
    [[ -s $merged ]] || fail "could not write the restored layout; shell.json is unchanged"
    mv "$merged" "$CONFIG_FILE"
    rm -f "$BACKUP_FILE"
  else
    # shell.json is missing or unreadable, so there are no later changes to keep.
    mv "$BACKUP_FILE" "$CONFIG_FILE"
  fi
  omarchy-shell -q shell reloadConfig >/dev/null 2>&1 || true
  omarchy bar background "$(jq -r '.bar.background // "opaque"' "$CONFIG_FILE" 2>/dev/null || echo opaque)" >/dev/null 2>&1 || true
  echo "Restored your bar to how it was before Omabar (your other shell settings are kept)"
}

if [[ ${1:-} == "--restore" ]]; then
  [[ -f $BACKUP_FILE ]] || fail "no backup at $BACKUP_FILE; for Omarchy's default bar run: omarchy bar defaults"
  command -v jq >/dev/null || fail "jq is required"
  # The backup is used up by restoring it, so the next setup backs up the
  # layout as it is then rather than keeping this one forever.
  restore_bar
  rm -f "$HOOK_FILE"
  exit 0
fi

if [[ ${1:-} == "--uninstall" ]]; then
  # 1. The world clock. A clone setup made is removed the way Omarchy removes
  #    any plugin, which also puts the built-in world clock back in its place.
  #    A clone you made yourself is kept and only loses Omabar's flap tiles.
  created=$(cat "$ELSEWHEN_RECORD" 2>/dev/null || true)
  for manifest in "$PLUGINS_DIR"/*/manifest.json; do
    [[ -f $manifest ]] || continue
    clone_id=$(jq -er 'select(.omarchy.clonedFrom? == "omarchy.elsewhen") | .id' "$manifest" 2>/dev/null) || continue
    clone_dir=$(dirname "$manifest")
    if [[ -n $created && $clone_id == "$created" ]]; then
      # A clone isn't a git checkout, so Omarchy keeps a dated backup of it
      # when it is removed. Only the backup this removal makes is Omabar's to
      # drop; any older backup under the same name is left alone.
      shopt -s nullglob
      backups_before=("$PLUGINS_DIR/.$clone_id.bak."*)
      if omarchy plugin remove "$clone_id" --yes >/dev/null 2>&1; then
        for backup in "$PLUGINS_DIR/.$clone_id.bak."*; do
          new=1
          for old in "${backups_before[@]}"; do
            [[ $backup == "$old" ]] && new=0 && break
          done
          ((new)) && rm -rf -- "$backup"
        done
        echo "Removed the world clock copy Omabar made ($clone_id)"
      else
        echo "omabar-setup: couldn't remove $clone_id; remove it with: omarchy plugin remove $clone_id" >&2
      fi
      shopt -u nullglob
    elif [[ -f $PLUGIN_DIR/tools/omabar-elsewhen-patch.py ]]; then
      python3 "$PLUGIN_DIR/tools/omabar-elsewhen-patch.py" --undo "$clone_dir" || true
    fi
  done

  # 2. The bar: your layout from before setup, or Omarchy's default bar when
  #    there's no backup and shell.json still points at Omabar.
  if [[ -f $BACKUP_FILE ]] && command -v jq >/dev/null; then
    restore_bar
  elif omabar_selected || grep -q "$PLUGIN_ID" "$CONFIG_FILE" 2>/dev/null; then
    omarchy bar defaults >/dev/null 2>&1 || true
    omarchy bar reset >/dev/null 2>&1 || true
    echo "Put back Omarchy's default bar"
  fi

  # 3. Everything else Omabar wrote: the update hook, its settings (Spotify
  #    login, calendar addresses, world clock cities), its cache and Focus
  #    mode, ended first so Do Not Disturb goes back to how it was.
  "$PLUGIN_DIR/bin/omabar-focus" stop >/dev/null 2>&1 || true
  rm -f "$HOOK_FILE"
  rm -rf "$OMABAR_CONFIG_DIR" "$OMABAR_CACHE_DIR" "$OMABAR_STATE_DIR"
  echo "Deleted Omabar's update hook, settings and cache"

  # 4. The plugin itself. exec, because this script lives inside it.
  if [[ -d $PLUGIN_DIR ]]; then
    exec omarchy plugin remove "$PLUGIN_ID" --yes
  fi
  exit 0
fi

if [[ ${1:-} == "--doctor" ]]; then
  doctor
  exit 0
fi

[[ -f $PLUGIN_DIR/manifest.json ]] || fail "Omabar isn't installed at $PLUGIN_DIR; run: omarchy plugin add https://github.com/goehringcory-lang/Omabar.git"
command -v jq >/dev/null || fail "jq is required"

[[ -f $DEFAULTS_FILE ]] || fail "Omarchy's shell isn't at $OMARCHY_PATH (no config/omarchy/shell.json there); Omabar needs Omarchy 4"

if [[ ${1:-} == "--rebuild" ]]; then
  if ! omabar_selected; then
    echo "Omabar isn't the bar in use, so there is nothing to rebuild."
    exit 0
  fi
  if engine_current; then
    echo "Omabar already matches this Omarchy."
    exit 0
  fi
  started=$(date '+%Y-%m-%d %H:%M:%S')
  build_engine
  reload_shell
  check_loaded "$started"
  exit
fi

mkdir -p "$(dirname "$CONFIG_FILE")" "${XDG_CACHE_HOME:-$HOME/.cache}/omabar" "${XDG_CONFIG_HOME:-$HOME/.config}/omabar"
build_engine

# The layout to start from: yours, or Omarchy's when you have none the shell
# can read (it uses its own then, too).
pick_source() {
  if [[ -s $CONFIG_FILE ]] && jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1; then
    source_file="$CONFIG_FILE"
  else
    source_file="$DEFAULTS_FILE"
  fi
}
pick_source
if [[ -s $CONFIG_FILE && $source_file != "$CONFIG_FILE" ]]; then
  echo "omabar-setup: $CONFIG_FILE isn't a layout the shell can read, so this one starts from Omarchy's defaults" >&2
fi

# Back up the layout from before Omabar, once: a second setup must not replace
# it with Omabar's own.
if [[ ! -f $BACKUP_FILE ]] && ! omabar_selected; then
  if [[ -s $CONFIG_FILE ]]; then
    cp "$CONFIG_FILE" "$BACKUP_FILE"
  else
    cp "$DEFAULTS_FILE" "$BACKUP_FILE"
  fi
  echo "Backed up your bar config to $BACKUP_FILE"
fi

# What is installed, read from each plugin's manifest the way the shell's own
# plugin manager does: [{ id, kinds, clonedFrom }]. Omabar itself is left out.
installed_plugins() {
  local manifest
  for manifest in "$PLUGINS_DIR"/*/manifest.json; do
    [[ -f $manifest ]] || continue
    jq -c '{ id: (.id // ""), kinds: (.kinds // []), clonedFrom: (.omarchy.clonedFrom? // "") }' "$manifest" 2>/dev/null || true
  done | jq -sc --arg self "$PLUGIN_ID" 'map(select(.id != "" and .id != $self)) | unique_by(.id)'
}
plugins_json=$(installed_plugins)
has_plugin() { jq -e --arg re "$1" 'any(.[]; .id | test($re; "i"))' <<<"$plugins_json" >/dev/null; }

# Your copy of Omarchy's world clock (Elsewhen), if one exists.
elsewhen_clone() {
  local manifest
  for manifest in "$PLUGINS_DIR"/*/manifest.json; do
    [[ -f $manifest ]] || continue
    jq -er 'select(.omarchy.clonedFrom? == "omarchy.elsewhen") | .id' "$manifest" 2>/dev/null && return 0
  done
  return 1
}
elsewhen_id=$(elsewhen_clone || echo "omarchy.elsewhen")

# World clock: keep Omarchy's Elsewhen, with split-flap times in the accent
# color. Done before the shell restarts, so the restyled clock is what the new
# shell reads. Cloning has the shell rewrite shell.json, so the layout below
# starts from that.
if [[ $elsewhen_id == "omarchy.elsewhen" ]]; then
  omarchy plugin clone omarchy.elsewhen >/dev/null 2>&1 || true
  elsewhen_id=$(elsewhen_clone || echo "omarchy.elsewhen")
  [[ $elsewhen_id == "omarchy.elsewhen" ]] || echo "$elsewhen_id" >"$ELSEWHEN_RECORD"
  pick_source
fi
if [[ $elsewhen_id != "omarchy.elsewhen" && -d $PLUGINS_DIR/$elsewhen_id ]]; then
  python3 "$PLUGIN_DIR/tools/omabar-elsewhen-patch.py" "$PLUGINS_DIR/$elsewhen_id" "$PLUGIN_DIR/modules" || true
fi

tmp=$(mktemp "$CONFIG_FILE.XXXXXX")
scratch+=("$tmp")

# The world clock's cities: the ones you just named with --world-clock, else
# the ones on its entry now (under whichever id it had), else the copy saved
# the last time setup ran. Saved afresh below, so a lost list comes back.
world_clock_saved="null"
if [[ -s $WORLD_CLOCK_FILE ]] && jq -e 'type == "array" and length > 0' "$WORLD_CLOCK_FILE" >/dev/null 2>&1; then
  world_clock_saved=$(jq -c . "$WORLD_CLOCK_FILE")
fi

jq -S \
  --arg bar "$PLUGIN_ID" \
  --arg dir "~/.config/omarchy/plugins/$PLUGIN_ID" \
  --argjson plugins "$plugins_json" \
  --arg elsewhen "$elsewhen_id" \
  --argjson worldClockOverride "${world_clock_override:-null}" \
  --argjson worldClockSaved "$world_clock_saved" '
  def obj: if type == "object" then . else {} end;
  # Bar widgets from plugins you installed, each placed exactly once. Clones of
  # built-in widgets are skipped: Omabar already draws its own clock,
  # workspaces and menu, and the shell routes omarchy.* ids to a clone anyway.
  ($plugins | map(select((.kinds | index("bar-widget")) and .clonedFrom == "") | .id)) as $widgets
  | ($widgets | map(select(test("ai-usagebar"; "i")))) as $usage
  | ($widgets | map(select(test("omaplug"; "i")))) as $omaplug
  | ($widgets - $usage - $omaplug) as $others
  # Omaland without a bar widget of its own gets a button that opens its panel.
  | ($plugins | map(select((.id | test("omaland"; "i")) and (.kinds | index("bar-widget") | not)) | .id) | first // "") as $omalandPanel
  |
  . as $old
  | .version = 1
  | .bar = (.bar | obj)
  | .bar.id = $bar
  | .bar.background = "glassy"
  | .bar.layout = {
      left: [
        { id: "omabar-menu", type: "qml", source: ($dir + "/modules/OmabarMenu.qml") },
        { id: "omabar-workspaces", type: "qml", source: ($dir + "/modules/OmabarWorkspaces.qml"), persistent: 5 }
      ],
      centerBegin: [
        { id: "omarchy.indicators" }
      ],
      center: [
        { id: "omabar-ask", type: "qml", source: ($dir + "/modules/OmabarAsk.qml") },
        { id: "omabar-player", type: "qml", source: ($dir + "/modules/OmabarPlayer.qml"), player: "spotify", maxWidth: 220 },
        { id: "omabar-clock", type: "qml", source: ($dir + "/modules/OmabarClock.qml") },
        # The Focus mode timer: it takes no room unless Focus mode is on.
        { id: "omabar-focus", type: "qml", source: ($dir + "/modules/OmabarFocus.qml") }
      ],
      centerEnd: (
        [ { id: $elsewhen } ]
        + ($omaplug | map({ id: . }))
        + [
            { id: "omabar-weather", type: "qml", source: ($dir + "/modules/OmabarWeather.qml") },
            { id: "omarchy.system-update" }
          ]
      ),
      # Always in view: AI usage, notifications, mail, settings, battery. The rest
      # waits in the hover drawer (tray).
      right: (
        # The drawer handle leads the group, so it stays leftmost and widgets
        # added later land to its right. It opens a panel below the bar
        # rather than widening the bar, so the clock is never covered.
        [ { id: "omabar-drawer", type: "qml", source: ($dir + "/modules/OmabarDrawer.qml") },
          { id: "omarchy.agents" } ]
        + ($usage | map({ id: . }))
        + [
            { id: "omabar-notifications", type: "qml", source: ($dir + "/modules/OmabarNotifications.qml") },
            { id: "omabar-mail", type: "qml", source: ($dir + "/modules/OmabarMail.qml"), app: "thunderbird" },
            { id: "omabar-settings", type: "command", text: "󰒓",
              tooltip: "Omarchy settings", onClick: "omarchy-menu toggle setup" },
            # Omabar battery widget: reads each pack, so a T480 removable
            # battery shows first and the internal one after it runs out.
            { id: "omabar-battery", type: "qml", source: ($dir + "/modules/OmabarBattery.qml") }
          ]
      ),
      tray: (
        (if $omalandPanel != "" then [ { id: "omabar-omaland", type: "command", text: "󰏘",
              tooltip: "Omaland: Hyprland look and feel",
              onClick: ("omarchy-shell shell toggle " + $omalandPanel + " {}") } ] else [] end)
        + ($others | map({ id: . }))
        + [
            { id: "omarchy.bluetooth" },
            { id: "omarchy.network" },
            { id: "omarchy.audio" },
            { id: "omarchy.monitor" },
            { id: "omarchy.keyboard-layout" }
          ]
      )
    }
  # Omaland opens from its drawer button only while the shell has it loaded.
  | if $omalandPanel != "" and (((.plugins // []) | map(objects | .id) | index($omalandPanel)) == null)
    then .plugins = ((.plugins // []) + [ { id: $omalandPanel } ]) else . end
  # No widget is carried over from the old layout: leftovers (clones of the
  # built-in clock or workspaces, older custom modules) would double up with
  # the Omabar ones. The old layout is kept in the backup.
  #
  # Settings are: what you set on a widget that is still here (omarchy bar
  # set omabar-clock twelveHour false, a pinned playlist) survives running
  # setup again. Anything setup itself sets on a widget is set afresh.
  | ($old | obj | .bar | obj | .layout | obj
      | [ .[] | arrays | .[] | objects | select(.id | type == "string") ]
      | map({ key: .id, value: del(.id, .type, .source, .exec, .interval, .text, .tooltip, .onClick, .onRightClick, .onMiddleClick) })
      | from_entries) as $kept
  | .bar.layout |= map_values(map(($kept[.id] // {}) + .))
  # The world clock saves its cities on its own entry. Find them under any id
  # it has had (omarchy.elsewhen, or a clone of it), so a renamed entry keeps
  # its list, and fall back to the saved copy if the entry has none.
  | ([ "omarchy.elsewhen", $elsewhen ]
      + ($plugins | map(select(.clonedFrom == "omarchy.elsewhen") | .id))) as $elsewhenIds
  | ([ ($old | obj | .bar | obj | .layout | obj | .[] | arrays | .[]),
       ($old | obj | .plugins | if type == "array" then .[] else empty end) ]
      | map(objects | select(((.id as $id | $elsewhenIds | index($id)) != null)
              and (.cities | type == "array" and length > 0))) | first | .cities?) as $oldCities
  | ($worldClockOverride // $oldCities // $worldClockSaved) as $cities
  | if $cities == null then .
    else .bar.layout |= map_values(map(if .id == $elsewhen then .cities = $cities | del(.zones) else . end))
    end
' "$source_file" >"$tmp"

[[ -s $tmp ]] || fail "could not write the new layout; your shell.json is unchanged"
started=$(date '+%Y-%m-%d %H:%M:%S')
mv "$tmp" "$CONFIG_FILE"

# Keep a copy of the world clock's cities outside shell.json.
world_clock_now=$(jq -c --arg id "$elsewhen_id" \
  '[ .bar.layout[]? | arrays | .[] | objects | select(.id == $id) | .cities | arrays ] | first // empty' \
  "$CONFIG_FILE" 2>/dev/null || true)
if [[ -n $world_clock_now && $world_clock_now != "[]" ]]; then
  mkdir -p "$(dirname "$WORLD_CLOCK_FILE")"
  jq . <<<"$world_clock_now" >"$WORLD_CLOCK_FILE"
fi
[[ -n $world_clock_override ]] &&
  echo "World clock: $(jq -r 'map(.name + (if .region then ", " + .region else "" end) + " (" + .zone + ")") | join(", ")' <<<"$world_clock_override")"

# After an Omarchy update the bar has to be rebuilt from the new shell's own;
# this has Omarchy do it at the end of `omarchy update`.
mkdir -p "$(dirname "$HOOK_FILE")"
cat >"$HOOK_FILE" <<HOOK
#!/bin/bash
# Installed by omabar-setup; removed by omabar-setup --restore or --uninstall.
# Rebuilds Omabar's bar when an Omarchy update has changed the shell's.
setup="\$HOME/.config/omarchy/plugins/$PLUGIN_ID/bin/omabar-setup"
if [[ -x \$setup ]]; then
  "\$setup" --rebuild
  exit 0
fi
# Omabar was removed without --uninstall. If the bar is still Omabar, put
# back the bar from before Omabar (or Omarchy's default bar), keeping every
# other shell.json setting as it is now, then remove this hook.
config="\$HOME/.config/omarchy/shell.json"
backup="\$config.before-omabar"
if [[ \$(jq -r '.bar.id // ""' "\$config" 2>/dev/null) == "$PLUGIN_ID" ]]; then
  if [[ -f \$backup ]] && jq -e 'type == "object"' "\$backup" >/dev/null 2>&1; then
    merged=\$(mktemp "\$config.XXXXXX")
    if jq --slurpfile before "\$backup" '$RESTORE_BAR_JQ' "\$config" >"\$merged" && [[ -s \$merged ]]; then
      mv "\$merged" "\$config"
      rm -f "\$backup"
    else
      rm -f "\$merged"
    fi
  else
    omarchy bar defaults >/dev/null 2>&1 || true
  fi
  omarchy-shell -q shell reloadConfig >/dev/null 2>&1 || true
fi
rm -f "\$0"
exit 0
HOOK

reload_shell
omarchy bar background glassy >/dev/null 2>&1 || true

check_loaded "$started"
has_plugin ai-usagebar || echo "Tip: add ai-usagebar for per-provider usage, then run this again: omarchy plugin add https://github.com/akitaonrails/ai-usagebar.git"
has_plugin omaplug || echo "Tip: add Omaplug to manage plugins from the bar, then run this again: omarchy plugin add https://github.com/fross100/omaplug.git"
has_plugin omaland || echo "Tip: add Omaland for a look-and-feel button, then run this again: omarchy plugin add https://github.com/bobby-nicholas/omaland.git"
